// DTH ROM for Electra G9 (G9) — generated by DTH Character Studio.
// DTH-Runtime: v97
// Self-contained: this single ApplyDTHCharacter() call carries the full
// character config AND all ROM morph definitions inline. It needs the DTH
// runtime (the hidden .DthWorkflow.dsa + .DthUtils.dsa + .DthOptions.dsa), which
// the studio installs ONCE in the DTH-Character-Studio root — two levels up from
// this script's <project>/<character>/ subfolder.

var dthCharacterConfig = {
  "genesis": "G9",
  "gender": "female",
  "characterName": "Electra G9",
  "runtimeVersion": 97,
  "studioVersion": "",
  "bIncludeJCM": true,
  "bIncludeFAC": true,
  "bIncludeDK": false,
  "bIncludeGP": true,
  "bIncludePhysics": true,
  "bDQS": true,
  "FACsDetailStrength": 1,
  "FlexionStrength": 1,
  "bApplyUE5TearUV": true,
  "presetFrames": {
    "base": 328,
    "gp": 104,
    "dk": 54,
    "phys": 43
  },
  "runLogPath": "C:/DTH/Project/.dcsmeta/characters/electra-g9/dth_rom_run_log.json",
  "cancelPath": "C:/DTH/Project/.dcsmeta/characters/electra-g9/.dth_export_cancel",
  "extraFrames": {
    "meta": {
      "version": "1.0",
      "description": "Electra G9 Full Body Morphs - relative frame offsets from ROM start"
    },
    "frames": [
      {
