  },
  "runLogPath": "C:/DTH/Project/.dcsmeta/characters/electra-g9/dth_rom_run_log.json",
  "cancelPath": "C:/DTH/Project/.dcsmeta/characters/electra-g9/.dth_export_cancel",
  "extraFrames": {
    "meta": {
      "version": "1.0",
      "description": "Electra G9 Full Body Morphs - relative frame offsets from ROM start"
