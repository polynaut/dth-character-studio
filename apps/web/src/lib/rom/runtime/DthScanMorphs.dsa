// DAZ Studio version 4.22.0.16 filetype DAZ Script

// DTH Character Studio — morph + bone index builder. Included by the visible
// Build_Genesis_Index.dsa installed next to this file (which also includes the
// DTH utils runtime first — this file calls into it for the generation-asset
// table and node asset URIs, and must NOT include it itself: the install-time
// rewrite would repoint the include two folders up).
//
// It does the whole job on its own — no per-generation wrapper scripts, no
// "select the figure first":
//   1. builds the stock figures for each generation, one generation at a time
//      (G3/G8/G8.1 female + male; Genesis 9 twice — it is gender-neutral, so the
//      pair is differentiated by geograft instead: Golden Palace on one,
//      Dicktator on the other), clearing the scene between generations so only
//      two figures are ever loaded at once — and once more when the last
//      generation is scanned, so the run ends on an empty scene instead of
//      leaving whatever it built last behind, and
//   2. scans EVERY figure root in the scene — the figure plus every descendant
//      node (geografts, nipples/navel add-ons, fitted clothing all carry morphs
//      of their own) — bucketing what it finds by the figure's generation, and
//   3. writes one per-generation JSON into the studio's app-data folder: every
//      morph dial as { node, nodeLabel, label, name } AND every bone as
//      { name, label }. The studio's Morph-name and bone (Modify-JCM)
//      autocompletes read those. Studio-only (no DazToHue-Scripts twin); the
//      wrapper bakes the output folder in at install time.
//
// It can also scan the OPEN scene as-is (offered when the scene already holds
// figures) — that is how you index morphs the stock figures don't carry:
// third-party geografts, add-ons, fitted clothing.
//
// Two passes per node, mirroring how the ROM runtime resolves a morph name
// (the DTH utils runtime: findProperty -> findPropertyByLabel -> morph-modifier
// scan):
//   1. DzMorph modifiers on the node's object (classic delta morphs), and
//   2. float properties on the node itself — controller dials without their
//      own deltas (ERC shape products like SL_Hourglass) live HERE, not as
//      modifiers, and would otherwise be invisible to the scan.

/**********************************************************************
 * The build plan: which stock assets make up each generation's scan. Genesis 9
 * is one figure asset twice, differentiated by its geograft.
 *
 * The stock figures resolve by path (`rel`, tried in order) with an anchored
 * bounded search behind it — Daz's own naming is stable enough for that.
 *
 * The two GEOGRAFTS do not: they are third-party and reship under new names and
 * folders ("Golden Palace" vs "Golden Palace 9", Smart_Vanilla vs Smart_Wild,
 * the older `…Genitalia_v2` naming), so no path list ages well. They carry a
 * `pick` spec instead and are found by the scored glob below — the paths in
 * their `rel` stay only as a fast/last-resort exact hit. Whatever the glob
 * settles on is named in the run summary, so a wrong pick is visible rather
 * than silent.
 */
function dthGenesisBuildPlan(){
	var aG9 = ["People/Genesis 9/Genesis 9.duf"];
	return [
		{
			genesis: "G3",
			figures: [
				{
					label: "Genesis 3 Female",
					short: "Female",
					rel: ["People/Genesis 3 Female/Genesis 3 Female.duf"],
					searchDirs: [{ dir: "People/Genesis 3 Female", depth: 1 }],
					searchRx: [/^genesis 3 (basic )?female\.duf$/]
				},
				{
					label: "Genesis 3 Male",
					short: "Male",
					rel: ["People/Genesis 3 Male/Genesis 3 Male.duf"],
					searchDirs: [{ dir: "People/Genesis 3 Male", depth: 1 }],
					searchRx: [/^genesis 3 (basic )?male\.duf$/]
				}
			]
		},
		{
			genesis: "G8",
			figures: [
				{
					label: "Genesis 8 Female",
					short: "Female",
					rel: [
						"People/Genesis 8 Female/Genesis 8 Basic Female.duf",
						"People/Genesis 8 Female/Genesis 8 Female.duf"
					],
					searchDirs: [{ dir: "People/Genesis 8 Female", depth: 1 }],
					searchRx: [/^genesis 8 (basic )?female\.duf$/]
				},
				{
					label: "Genesis 8 Male",
					short: "Male",
					rel: [
						"People/Genesis 8 Male/Genesis 8 Basic Male.duf",
						"People/Genesis 8 Male/Genesis 8 Male.duf"
					],
					searchDirs: [{ dir: "People/Genesis 8 Male", depth: 1 }],
					searchRx: [/^genesis 8 (basic )?male\.duf$/]
				}
			]
		},
		{
			genesis: "G8.1",
			figures: [
				{
					label: "Genesis 8.1 Female",
					short: "Female",
					// 8.1 ships INTO the Genesis 8 Female folder; the dedicated
					// 8.1 folder is the layout some manual installs end up with.
					rel: [
						"People/Genesis 8 Female/Genesis 8.1 Basic Female.duf",
						"People/Genesis 8.1 Female/Genesis 8.1 Basic Female.duf",
						"People/Genesis 8 Female/Genesis 8.1 Female.duf"
					],
					searchDirs: [{ dir: "People/Genesis 8 Female", depth: 1 }],
					searchRx: [/^genesis 8\.1 (basic )?female\.duf$/]
				},
				{
					label: "Genesis 8.1 Male",
					short: "Male",
					rel: [
						"People/Genesis 8 Male/Genesis 8.1 Basic Male.duf",
						"People/Genesis 8.1 Male/Genesis 8.1 Basic Male.duf",
						"People/Genesis 8 Male/Genesis 8.1 Male.duf"
					],
					searchDirs: [{ dir: "People/Genesis 8 Male", depth: 1 }],
					searchRx: [/^genesis 8\.1 (basic )?male\.duf$/]
				}
			]
		},
		{
			genesis: "G9",
			figures: [
				{
					label: "Genesis 9 + Golden Palace",
					short: "with Golden Palace",
					rel: aG9,
					searchDirs: [{ dir: "People/Genesis 9", depth: 1 }],
					searchRx: [/^genesis 9\.duf$/],
					graft: {
						name: "Golden Palace",
						// Known paths as of GP9 2026-07, Smart preset first: both fit
						// the graft to the selected figure, but only the Smart one also
						// brings the geoshells (Minora + Majora) - and those parent to
						// the FIGURE, so they get scanned with it. The manual-setup
						// graft yields the graft alone, no shells. Same order the pick
						// scores in, so an exact path hit and a glob hit agree.
						rel: [
							"People/Genesis 9/Anatomy/Golden Palace/2a-Golden Palace Smart_Vanilla.duf",
							"People/Genesis 9/Anatomy/Golden Palace/00-Manual Setup/2-Golden Palace Graft.duf"
						],
						pick: {
							glob: /golden.?palace/,
							prefer: [
								{ rx: /smart/, score: 50 },
								{ rx: /graft|genitalia/, score: 20 },
								{ rx: /vanilla/, score: 2 }
							]
						}
					}
				},
				{
					label: "Genesis 9 + Dicktator",
					short: "with Dicktator",
					rel: aG9,
					searchDirs: [{ dir: "People/Genesis 9", depth: 1 }],
					searchRx: [/^genesis 9\.duf$/],
					graft: {
						name: "Dicktator",
						// Smart preset first for the same reason: it adds the shaft +
						// foreskin geoshells alongside the graft.
						rel: [
							"People/Genesis 9/Anatomy/Dicktator/1-Dicktator_Smart.duf",
							"People/Genesis 9/Anatomy/Dicktator/00-Manual Setup/1-Dicktator.duf"
						],
						pick: {
							glob: /dicktator/,
							prefer: [
								{ rx: /smart/, score: 50 },
								{ rx: /graft|genitalia/, score: 20 }
							]
						}
					}
				}
			]
		}
	];
}

/**********************************************************************
 * Content resolution — the studio installs this runtime at
 * <Daz library>/Scripts/DTH-Character-Studio, so the wrapper's own folder
 * yields one guaranteed content root; Daz's content manager supplies the rest
 * (extra libraries, mapped/cloud dirs). Every API call past the derived root is
 * typeof/try-guarded: a Daz build that names one differently degrades to the
 * remaining lookups instead of dying silently mid-script.
 */

/** `<lib>` from `<lib>/Scripts/DTH-Character-Studio` ('' when the script was
 *  moved out of its install folder). */
function dthLibraryRootFromScriptDir(sDir){
	var s = String(sDir).replace(/\\/g, "/").replace(/\/+$/, "");
	var rx = /\/Scripts\/DTH-Character-Studio$/i;
	if(rx.test(s)) return s.replace(rx, "");
	return "";
}

function dthPushRoot(aRoots, oSeen, sPath){
	if(!sPath) return;
	var s = String(sPath).replace(/\\/g, "/").replace(/\/+$/, "");
	if(s == "" || oSeen[s.toLowerCase()]) return;
	oSeen[s.toLowerCase()] = true;
	aRoots.push(s);
}

/** Every Daz content root to probe, the install's own library first. */
function dthContentRoots(sScriptDir){
	var aRoots = [];
	var oSeen = {};
	dthPushRoot(aRoots, oSeen, dthLibraryRootFromScriptDir(sScriptDir));
	try {
		var oCM = App.getContentMgr();
		if(oCM && typeof oCM.getNumContentDirectories == "function"){
			var iNum = oCM.getNumContentDirectories();
			for(var i = 0; i < iNum; i++){
				if(typeof oCM.getContentDirectoryPath == "function")
					dthPushRoot(aRoots, oSeen, oCM.getContentDirectoryPath(i));
				else if(typeof oCM.getContentDirectory == "function")
					dthPushRoot(aRoots, oSeen, oCM.getContentDirectory(i));
			}
		}
	} catch(e){ /* no enumerable content dirs — the derived root still stands */ }
	return aRoots;
}

/** The file name out of a path — what the run summary reports, so the user can
 *  see WHICH asset a search settled on without reading a full path. */
function dthBaseName(sPath){
	return String(sPath).replace(/\\/g, "/").replace(/^.*\//, "");
}

/** True when `sPath` is a readable file. */
function dthFileExists(sPath){
	try {
		var oInfo = new DzFileInfo(sPath);
		if(typeof oInfo.exists == "function") return oInfo.exists();
	} catch(e){ /* fall through to the open() probe */ }
	try {
		var oFile = new DzFile(sPath);
		if(oFile.open(DzFile.ReadOnly)){
			oFile.close();
			return true;
		}
	} catch(e){ /* unreadable */ }
	return false;
}

/** Ask Daz to resolve a content-relative path (covers mapped + cloud dirs). */
function dthContentFindFile(sRel){
	try {
		var oCM = App.getContentMgr();
		if(!oCM || typeof oCM.findFile != "function") return "";
		var sHit;
		if(typeof DzContentMgr != "undefined" && DzContentMgr.AllDirsAndCloud != undefined)
			sHit = oCM.findFile(sRel, DzContentMgr.AllDirsAndCloud);
		else
			sHit = oCM.findFile(sRel);
		return sHit ? String(sHit) : "";
	} catch(e){ return ""; }
}

/** Bounded breadth-first walk for a .duf matching `rxName` and NOT `rxExclude`
 *  (both tested against the lowercased file name) under `sDir`. The SHORTEST
 *  match wins — the setup file beats the longer variants that share its name. */
function dthFindDufUnder(sDir, rxName, rxExclude, iMaxDepth){
	var sBest = "";
	var sBestName = "";
	try {
		var aQueue = [{ dir: String(sDir), depth: 0 }];
		var iVisited = 0;
		// Generous enough for the whole `Anatomy` tree of a big library (vendor
		// folder per product, a few subfolders each) — this only runs when the
		// known paths all missed, and the walk is entryList() calls, not loads.
		while(aQueue.length && iVisited < 400){
			var oItem = aQueue.shift();
			iVisited++;
			var oDir = new DzDir(oItem.dir);
			if(!oDir.exists()) continue;
			var aEntries = oDir.entryList();
			for(var i = 0; i < aEntries.length; i++){
				var sName = String(aEntries[i]);
				var sLow = sName.toLowerCase();
				if(sLow.lastIndexOf(".duf") != sLow.length - 4) continue;
				if(!rxName.test(sLow)) continue;
				if(rxExclude && rxExclude.test(sLow)) continue;
				if(sBest == "" || sName.length < sBestName.length){
					sBest = oItem.dir + "/" + sName;
					sBestName = sName;
				}
			}
			if(oItem.depth >= iMaxDepth) continue;
			var aSubs = typeof oDir.getSubdirList == "function" ? oDir.getSubdirList() : aEntries;
			for(var s = 0; s < aSubs.length; s++){
				var sSub = String(aSubs[s]);
				if(sSub == "." || sSub == "..") continue;
				var sFull = oItem.dir + "/" + sSub;
				if(new DzDir(sFull).exists()) aQueue.push({ dir: sFull, depth: oItem.depth + 1 });
			}
		}
	} catch(e){ /* unreadable tree — treated as "not found" */ }
	return sBest;
}

/**********************************************************************
 * The scored glob — how the two geograft products are found.
 *
 * They are third-party and reship freely: "Golden Palace" vs "Golden Palace 9",
 * Smart_Vanilla vs Smart_Wild, "1-Dicktator" vs "1_Dicktator Genitalia 0.3",
 * sometimes under a vendor folder. So instead of trusting a path, glob the whole
 * People tree for the product NAME and rank what comes back.
 *
 * Ranking is not cosmetic — the same glob finds the OLDER GENERATION's version
 * of both products (measured: People/Genesis 8 Female/Anatomy/Golden Palace v2/
 * 1-GoldenPalace_Genitalia_v2.duf, People/Genesis 8 Male/Anatomy/Dicktator v3/
 * 1_Dicktator Genitalia 0.3.duf), and fitting a G8 geograft to a Genesis 9
 * figure would be wrong. The generation term dominates the score and
 * `minScore` is above zero, so a wrong-generation-only install resolves to
 * NOTHING (reported as not installed) rather than to the wrong graft.
 */

/** Path terms every product shares: which generation the asset belongs to. */
var DTH_PICK_PATH_SCORE = [
	{ rx: /genesis.?9|[\/_\- ]g9/, score: 100 },
	{ rx: /genesis.?[2-8]|[\/_\- ]g[2-8]/, score: -100 }
];

/** File-name terms no product's setup file can be: the geoshells, material and
 *  pose presets, UV fixes and rigidity files that sit right next to it. */
var DTH_PICK_REJECT = /shell|uv.?fix|rigidity|material|opacity|preset|tutorial|zero|pose|shap|cum|fluid|hair|clit|vagzilla/;

/** Where the glob looks. One root, deep enough for
 *  People/<figure>/Anatomy/<vendor>/<product>/<setup folder>/. */
var DTH_PICK_SEARCH_DIR = "People";
var DTH_PICK_SEARCH_DEPTH = 5;

/** Collect every .duf under `sDir` whose FILE NAME matches `rxGlob` and isn't
 *  rejected. `oBudget.left` bounds the whole walk (shared across roots). */
function dthCollectDufs(sDir, rxGlob, aOut, oBudget){
	try {
		var aQueue = [{ dir: String(sDir), depth: 0 }];
		while(aQueue.length && oBudget.left > 0){
			var oItem = aQueue.shift();
			oBudget.left--;
			var oDir = new DzDir(oItem.dir);
			if(!oDir.exists()) continue;
			var aEntries = oDir.entryList();
			for(var i = 0; i < aEntries.length; i++){
				var sName = String(aEntries[i]);
				var sLow = sName.toLowerCase();
				if(sLow.lastIndexOf(".duf") != sLow.length - 4) continue;
				if(!rxGlob.test(sLow)) continue;
				if(DTH_PICK_REJECT.test(sLow)) continue;
				aOut.push({ path: oItem.dir + "/" + sName, name: sName });
			}
			if(oItem.depth >= DTH_PICK_SEARCH_DEPTH) continue;
			var aSubs = typeof oDir.getSubdirList == "function" ? oDir.getSubdirList() : aEntries;
			for(var s = 0; s < aSubs.length; s++){
				var sSub = String(aSubs[s]);
				if(sSub == "." || sSub == "..") continue;
				var sFull = oItem.dir + "/" + sSub;
				if(new DzDir(sFull).exists()) aQueue.push({ dir: sFull, depth: oItem.depth + 1 });
			}
		}
	} catch(e){ /* unreadable tree — whatever was collected still ranks */ }
}

/** Plausibility of one candidate: generation first, then how complete a setup
 *  the file name says it is. */
function dthScoreCandidate(oCand, oPick){
	var sPathLow = oCand.path.toLowerCase();
	var sNameLow = oCand.name.toLowerCase();
	var iScore = 0;
	var i;
	for(i = 0; i < DTH_PICK_PATH_SCORE.length; i++){
		if(DTH_PICK_PATH_SCORE[i].rx.test(sPathLow)) iScore += DTH_PICK_PATH_SCORE[i].score;
	}
	var aPrefer = oPick.prefer ? oPick.prefer : [];
	for(i = 0; i < aPrefer.length; i++){
		if(aPrefer[i].rx.test(sNameLow)) iScore += aPrefer[i].score;
	}
	return iScore;
}

/** Whether a candidate outranks the incumbent: score first, then the shorter
 *  file name, then the shorter path — both tie-breaks stable across runs,
 *  unlike directory-listing order. */
function dthCandBeats(oA, iA, oB, iB){
	if(iA != iB) return iA > iB;
	if(oA.name.length != oB.name.length) return oA.name.length < oB.name.length;
	return oA.path.length < oB.path.length;
}

/** Best-scoring asset for a glob spec, or '' when nothing plausible exists.
 *  Every candidate and its score is printed, so a surprising pick is
 *  diagnosable from the Daz log without re-running anything. */
function dthPickAsset(aRoots, oPick){
	var aCands = [];
	var oBudget = { left: 2500 };
	for(var r = 0; r < aRoots.length; r++){
		dthCollectDufs(aRoots[r] + "/" + DTH_PICK_SEARCH_DIR, oPick.glob, aCands, oBudget);
	}
	var oBest = null;
	var iBest = 0;
	for(var c = 0; c < aCands.length; c++){
		var oCand = aCands[c];
		var iScore = dthScoreCandidate(oCand, oPick);
		print("  candidate", iScore, oCand.path);
		// Must be positively plausible: a wrong-generation-only install scores
		// negative and is never loaded (reported as not installed instead).
		if(iScore <= 0) continue;
		if(oBest && !dthCandBeats(oCand, iScore, oBest, iBest)) continue;
		oBest = oCand;
		iBest = iScore;
	}
	if(oBest){
		print("Picked", oBest.path, "(score", iBest + ")");
		return oBest.path;
	}
	if(oBudget.left <= 0) print("Glob budget exhausted before a plausible match was found.");
	return "";
}

/** Absolute path of a planned asset: for a glob spec (the geografts) the scored
 *  pick above leads, since it ages better than any path list; then Daz's own
 *  lookup and a direct probe of the known relative paths as the fast/last
 *  resort; then the anchored bounded search the stock figures use. '' when
 *  nothing matched. */
function dthResolveAsset(aRoots, oSpec){
	var i, r;
	if(oSpec.pick){
		var sPicked = dthPickAsset(aRoots, oSpec.pick);
		if(sPicked) return sPicked;
	}
	for(i = 0; i < oSpec.rel.length; i++){
		var sHit = dthContentFindFile(oSpec.rel[i]);
		if(sHit && dthFileExists(sHit)) return sHit;
	}
	for(r = 0; r < aRoots.length; r++){
		for(i = 0; i < oSpec.rel.length; i++){
			var sFull = aRoots[r] + "/" + oSpec.rel[i];
			if(dthFileExists(sFull)) return sFull;
		}
	}
	if(oSpec.searchDirs && oSpec.searchRx){
		// Regex order is the preference order (Smart preset before the bare
		// graft), so an earlier pattern wins across ALL roots and search dirs
		// before a later one is tried at all — a Smart preset found in a renamed
		// product folder still beats a bare graft sitting at the expected path.
		for(var x = 0; x < oSpec.searchRx.length; x++){
			for(var d = 0; d < oSpec.searchDirs.length; d++){
				for(r = 0; r < aRoots.length; r++){
					var sFound = dthFindDufUnder(
						aRoots[r] + "/" + oSpec.searchDirs[d].dir,
						oSpec.searchRx[x],
						oSpec.searchExclude,
						oSpec.searchDirs[d].depth);
					if(sFound) return sFound;
				}
			}
		}
	}
	return "";
}

/**********************************************************************
 * Scene building
 */

/** Every root node currently in the scene. */
function dthSceneRootNodes(){
	var aRoots = [];
	for(var i = 0; i < Scene.getNumNodes(); i++){
		var oNode = Scene.getNode(i);
		if(oNode && !oNode.getNodeParent()) aRoots.push(oNode);
	}
	return aRoots;
}

/** Root FIGURE nodes (a figure root is a DzSkeleton/DzFigure, never a prop). */
function dthSceneFigureRoots(){
	var aFigures = [];
	var aRoots = dthSceneRootNodes();
	for(var i = 0; i < aRoots.length; i++){
		var oNode = aRoots[i];
		if(oNode.inherits("DzFigure") || oNode.inherits("DzSkeleton")) aFigures.push(oNode);
	}
	return aFigures;
}

/** Empty the scene. Scene.clear() when the build has it, else remove every
 *  root node (a child goes with its parent). */
function dthClearScene(){
	try {
		if(typeof Scene.clear == "function"){
			Scene.clear();
			return;
		}
	} catch(e){ /* fall through to the manual sweep */ }
	var aRoots = dthSceneRootNodes();
	for(var i = 0; i < aRoots.length; i++){
		try { Scene.removeNode(aRoots[i]); } catch(e2){ /* already gone */ }
	}
}

/** Load a figure asset and return the root node it added. Both character and
 *  wearable presets MERGE into the scene, so the new figure is found by
 *  diffing the root set rather than trusting the selection. */
function dthLoadFigure(sPath){
	var oBefore = {};
	var aBefore = dthSceneRootNodes();
	var i;
	for(i = 0; i < aBefore.length; i++) oBefore[String(aBefore[i].name)] = true;
	Scene.selectAllNodes(false);
	print("Loading figure:", sPath);
	if(!App.getContentMgr().openFile(sPath)){
		print("Failed to load figure:", sPath);
		return null;
	}
	var aFigures = dthSceneFigureRoots();
	for(i = 0; i < aFigures.length; i++){
		if(!oBefore[String(aFigures[i].name)]) return aFigures[i];
	}
	// Every root was already there — the asset merged into an existing figure
	// (or added nothing). The last figure root is the best guess to scan.
	return aFigures.length ? aFigures[aFigures.length - 1] : null;
}

/** Fit a geograft (a WEARABLE preset — it needs its target selected) onto
 *  `oFigure`. Returns whether the load reported success. */
function dthLoadGraft(sPath, oFigure){
	Scene.selectAllNodes(false);
	oFigure.select(true);
	Scene.setPrimarySelection(oFigure);
	print("Loading graft:", sPath, "onto", oFigure.getLabel());
	if(App.getContentMgr().openFile(sPath)) return true;
	print("Failed to load graft:", sPath);
	return false;
}

/**********************************************************************
 * Scanning
 */

// Node-property groups that are rig/scene plumbing, not morph dials. Any
// float property under these is skipped in pass 2 (transforms, display
// toggles, simulation weights, smoothing iterations, ...).
var DTH_RX_SKIP_GROUP = /^(General|Transforms|Display|Simulation|Smoothing|Mesh Smoothing|Line Tessellation|Rigid Follow|Instances)($|\/)/;

/** A per-generation accumulator: the morph + bone lists plus their dedup sets. */
function dthNewIndexAcc(){
	return {
		morphs: [],
		bones: [],
		figures: [],
		seenMorph: {},
		seenBone: {},
		nodesWithMorphs: 0
	};
}

/**
 * Scan one figure root and every descendant into `oAcc`. Deduped across
 * figures by node id + internal name, so the two figures of a generation merge
 * into one index (their shared dials land once, their gender- or
 * graft-specific ones all land).
 */
function dthScanFigureInto(oFigure, oAcc){
	// The figure root plus every descendant (recursive) - grafts and clothing too.
	var aNodes = [oFigure].concat(oFigure.getNodeChildren(true));
	oAcc.figures.push(String(oFigure.getLabel()));
	for(var n = 0; n < aNodes.length; n++){
		var oNode = aNodes[n];
		// Instance suffixes (GoldenPalace_G9_9694) vary per scene - strip the
		// trailing _<digits> so the stored node id matches the ROM convention
		// (GoldenPalace_G9, Genesis9, ...). It also collapses the second figure
		// of a generation (Genesis9_2) onto the first.
		var sNode = String(oNode.name).replace(/_\d+$/, "");
		var sNodeLabel = String(oNode.getLabel());
		var iBefore = oAcc.morphs.length;

		// Bones carry no morph dials (skipped by pass 2 below), but a JCM rule
		// keys off a bone's rotation - so collect every bone's internal name +
		// UI label for the studio's bone autocomplete. Deduped by internal name.
		if(oNode.inherits("DzBone")){
			if(!oAcc.seenBone[sNode]){
				oAcc.seenBone[sNode] = true;
				oAcc.bones.push({ name: sNode, label: sNodeLabel });
			}
		}

		// Pass 1: DzMorph modifiers on the node's object (delta morphs).
		var oObj = oNode.getObject();
		if(oObj){
			for(var i = 0; i < oObj.getNumModifiers(); i++){
				var oMod = oObj.getModifier(i);
				if(!oMod || !oMod.inherits("DzMorph")) continue;
				var oProp = oMod.getValueControl();
				var sName = String(oMod.getName());
				var sKey = sNode + "|" + sName;
				if(oAcc.seenMorph[sKey]) continue;
				oAcc.seenMorph[sKey] = true;
				oAcc.morphs.push({
					node: sNode,
					nodeLabel: sNodeLabel,
					label: oProp ? String(oProp.getLabel()) : sName,
					name: sName
				});
			}
		}

		// Pass 2: controller dials that live as float properties on the node
		// (no modifier of their own). Bones only carry transforms/rig floats,
		// so they are skipped wholesale.
		if(!oNode.inherits("DzBone")){
			for(var p = 0; p < oNode.getNumProperties(); p++){
				var oNProp = oNode.getProperty(p);
				if(!oNProp || !oNProp.inherits("DzFloatProperty")) continue;
				if(DTH_RX_SKIP_GROUP.test(String(oNProp.getPath()).replace(/^\//, ""))) continue;
				var sPName = String(oNProp.getName());
				var sPKey = sNode + "|" + sPName;
				if(oAcc.seenMorph[sPKey]) continue;
				oAcc.seenMorph[sPKey] = true;
				oAcc.morphs.push({
					node: sNode,
					nodeLabel: sNodeLabel,
					label: String(oNProp.getLabel()),
					name: sPName
				});
			}
		}

		if(oAcc.morphs.length > iBefore) oAcc.nodesWithMorphs++;
	}
}

/** Which generation a figure root belongs to, from its source asset
 *  (genesis9.dsf, genesis8_1female.dsf, ...). Null when it is not a stock
 *  Genesis figure the studio knows. */
function dthDetectGenesis(oNode){
	var aGenesis = ["G9", "G8.1", "G8", "G3"];
	var sPath = dthNodeAssetPath(oNode);
	if(sPath == "") return null;
	for(var g = 0; g < aGenesis.length; g++){
		var aFiles = dthGenerationAssetFiles(aGenesis[g]);
		if(!aFiles) continue;
		for(var f = 0; f < aFiles.length; f++){
			if(sPath.indexOf("/" + aFiles[f]) >= 0 || sPath == aFiles[f]) return aGenesis[g];
		}
	}
	return null;
}

/**
 * Scan every figure root in the scene into per-generation accumulators, keyed
 * by detected generation. `oByGen` is reused across calls so a build can scan
 * one generation's scene at a time and still merge into one index per file.
 * `sAssumeGenesis` is the build path's ground truth — it has just loaded that
 * generation's figures into an emptied scene, so a figure whose asset URI can't
 * be read (an API difference makes dthNodeAssetPath degrade to '') is filed
 * under it instead of being dropped, which would otherwise lose the whole
 * generation's index. The open-scene path passes nothing and stays strict.
 * Returns the number of figure roots whose generation could not be resolved.
 */
function dthScanSceneInto(oByGen, sAssumeGenesis){
	var aFigures = dthSceneFigureRoots();
	var iUnknown = 0;
	for(var i = 0; i < aFigures.length; i++){
		var oFigure = aFigures[i];
		var sGenesis = dthDetectGenesis(oFigure);
		if(!sGenesis && sAssumeGenesis) sGenesis = sAssumeGenesis;
		if(!sGenesis){
			print("Skipping (not a stock Genesis figure):", oFigure.getLabel());
			iUnknown++;
			continue;
		}
		if(!oByGen[sGenesis]) oByGen[sGenesis] = dthNewIndexAcc();
		print("Scanning", oFigure.getLabel(), "as", sGenesis);
		dthScanFigureInto(oFigure, oByGen[sGenesis]);
	}
	return iUnknown;
}

/**********************************************************************
 * Output
 */

/** Write one generation's index. The studio reads `morphs` + `bones` and
 *  tolerates the rest, so the metadata is for humans debugging a scan. */
function dthWriteIndex(sOutDir, sGenesis, oAcc){
	var sPath = String(sOutDir).replace(/\\/g, "/").replace(/\/+$/, "") + "/morphs_" + sGenesis + ".json";
	var oOut = {
		version: 3,
		genesis: sGenesis,
		figures: oAcc.figures,
		scannedAt: new Date().toString(),
		morphs: oAcc.morphs,
		bones: oAcc.bones
	};
	var oFile = new DzFile(sPath);
	// One ORed mode arg - a second open() argument warns on DS6.
	if(oFile.open(oFile.WriteOnly | oFile.Truncate)){
		oFile.write(JSON.stringify(oOut, null, 1));
		oFile.close();
		print("Wrote", oAcc.morphs.length, "morphs and", oAcc.bones.length, "bones to", sPath);
		return true;
	}
	print("Could not write the morph index:", sPath);
	return false;
}

/**********************************************************************
 * Progress — fully guarded: a Daz build without DzProgress just runs silently
 * rather than taking the whole script down with it.
 */
function dthProgressStart(sInfo, iSteps){
	try {
		if(typeof DzProgress != "undefined") return new DzProgress(sInfo, iSteps);
	} catch(e){ /* no progress bar */ }
	return null;
}

function dthProgressStep(oProgress, sInfo){
	if(!oProgress) return;
	try {
		if(sInfo && typeof oProgress.setInfo == "function") oProgress.setInfo(sInfo);
		if(typeof oProgress.step == "function") oProgress.step();
	} catch(e){ /* ignore */ }
}

function dthProgressFinish(oProgress){
	if(!oProgress) return;
	try { if(typeof oProgress.finish == "function") oProgress.finish(); } catch(e){ /* ignore */ }
}

/**********************************************************************
 * Pre-flight: what is actually installed?
 *
 * Every asset resolves BEFORE the scene is touched, so the confirm dialog can
 * name exactly what will be built and what will be skipped — and so a library
 * missing a generation (or missing both geografts, or everything) never costs
 * the user their open scene for nothing. Read-only: no load, no clear.
 *
 * Annotates the plan in place — each figure gets `asset`, each graft
 * `graft.asset` — and gives every generation a `ready` list of the figures that
 * can be built. A generation with an empty `ready` list is skipped whole.
 */
function dthResolvePlan(aPlan, aRoots){
	var oReport = {
		buildable: [],
		skippedGenesis: [],
		skippedFigures: [],
		missingGrafts: [],
		grafts: []
	};
	for(var g = 0; g < aPlan.length; g++){
		var oGen = aPlan[g];
		var aReady = [];
		var oSeenBuild = {};
		for(var f = 0; f < oGen.figures.length; f++){
			var oSpec = oGen.figures[f];
			print("Resolving", oSpec.label, "...");
			oSpec.asset = dthResolveAsset(aRoots, oSpec);
			if(!oSpec.asset){
				oReport.skippedFigures.push(oSpec.label);
				continue;
			}
			oSpec.graftAsset = "";
			if(oSpec.graft){
				oSpec.graftAsset = dthResolveAsset(aRoots, oSpec.graft);
				if(oSpec.graftAsset)
					// The graft products reship under new names, so the file the
					// glob settled on is reported: the one resolution here that
					// can't be verified up front is verifiable after the fact.
					oReport.grafts.push(oSpec.graft.name + " <- " + dthBaseName(oSpec.graftAsset));
				else
					oReport.missingGrafts.push(oSpec.graft.name);
			}
			// Genesis 9's two entries are the SAME figure asset differing only by
			// geograft — with neither geograft installed they would build and scan
			// two identical figures, so collapse them to one.
			var sKey = oSpec.asset.toLowerCase() + "|" + oSpec.graftAsset.toLowerCase();
			if(oSeenBuild[sKey]) continue;
			oSeenBuild[sKey] = true;
			aReady.push(oSpec);
		}
		// A graft-LESS entry only earns its place when no sibling got its
		// geograft: it loads the same figure asset, so everything it could
		// contribute is already in a grafted sibling's scan. It exists purely so
		// Genesis 9 still gets indexed when neither geograft is installed.
		var bAnyGraft = false;
		var i;
		for(i = 0; i < aReady.length; i++){
			if(aReady[i].graft && aReady[i].graftAsset) bAnyGraft = true;
		}
		if(bAnyGraft){
			var aKeep = [];
			for(i = 0; i < aReady.length; i++){
				if(!aReady[i].graft || aReady[i].graftAsset) aKeep.push(aReady[i]);
			}
			aReady = aKeep;
		}
		oGen.ready = aReady;
		if(aReady.length) oReport.buildable.push(oGen);
		else oReport.skippedGenesis.push(dthGenesisLabel(oGen.genesis));
	}
	return oReport;
}

/** The generation key as users read it: G8.1 -> "Genesis 8.1". */
function dthGenesisLabel(sGenesis){
	return "Genesis " + String(sGenesis).replace(/^G/, "");
}

/** How one ready figure reads in the confirm dialog. */
function dthFigureBuildLabel(oSpec){
	if(!oSpec.graft) return oSpec.short;
	if(oSpec.graftAsset) return oSpec.short;
	return "plain (no geograft installed)";
}

/**********************************************************************
 * Scene scan — the SECOND mode.
 *
 * The build above indexes what the STOCK figures carry. This one indexes what a
 * particular saved scene adds on top: fitted clothing, hair, third-party
 * geografts and add-ons all carry morph dials of their own, and none of them
 * exist on a bare Genesis figure. It scans every node in the OPEN scene, keeps
 * only the dials the base index doesn't already have, and files them under the
 * scene they were found in — so the studio's Morph-name autocomplete can offer
 * a jacket's "Expand All" only while that jacket's scene is the one selected.
 *
 * The two indexes are separate FILES on purpose: a base rebuild rewrites
 * `morphs_<G>.json` wholesale, and merging scene finds into it would lose them
 * on every rebuild. The studio reads both and merges at load time, so from the
 * outside it is still one index.
 */

/** The per-generation SCENE index (base index's sibling). */
function dthSceneIndexPath(sOutDir, sGenesis){
	return String(sOutDir).replace(/\\/g, "/").replace(/\/+$/, "") +
		"/morphs_scenes_" + sGenesis + ".json";
}

/** Read + parse a JSON file, or null when it is missing/unreadable/garbage. */
function dthReadJson(sPath){
	try {
		var oFile = new DzFile(sPath);
		if(!oFile.open(oFile.ReadOnly)) return null;
		var sText = String(oFile.read());
		oFile.close();
		return JSON.parse(sText);
	} catch(e){ return null; }
}

/** The scene-path convention shared with the studio (normalizeSceneKey in
 *  execute-jobs.ts): trimmed, '/'-separators, lowercased. It is what the
 *  autocomplete matches the selected scene against, so both sides must agree. */
function dthSceneKey(sPath){
	return String(sPath).replace(/^\s+|\s+$/g, "").replace(/\\/g, "/").toLowerCase();
}

/** Every `node|name` key the BASE index already holds for a generation — what a
 *  scene scan filters itself against, so the scene index only ever carries what
 *  the stock figures genuinely don't have. */
function dthBaseIndexKeys(sOutDir, sGenesis){
	var oKeys = {};
	var sPath = String(sOutDir).replace(/\\/g, "/").replace(/\/+$/, "") +
		"/morphs_" + sGenesis + ".json";
	var oIndex = dthReadJson(sPath);
	if(!oIndex || !oIndex.morphs){
		print("No base index at", sPath, "- every scanned morph counts as new.");
		return oKeys;
	}
	for(var i = 0; i < oIndex.morphs.length; i++){
		var oM = oIndex.morphs[i];
		if(oM && oM.node && oM.name) oKeys[String(oM.node) + "|" + String(oM.name)] = true;
	}
	print("Base index holds", oIndex.morphs.length, "morphs for", sGenesis);
	return oKeys;
}

/**
 * Scan EVERY node in the scene (each root and all its descendants), not just the
 * figure roots the build path walks: a scene scan is looking for what is WORN
 * and what is parented in, and a prop or a hair item that sits outside the
 * figure hierarchy carries dials just the same.
 *
 * Cameras and lights are skipped whole. They are scene furniture, not something
 * a ROM ever dials — but their float properties (focal length, intensity,
 * falloff) are NOT under any of DTH_RX_SKIP_GROUP's rig/plumbing groups, so
 * without this they would sail through pass 2, miss the base index (the stock
 * figures carry none of them) and land in the scene index as suggestions.
 */
function dthScanWholeSceneInto(oAcc){
	var aRoots = dthSceneRootNodes();
	for(var i = 0; i < aRoots.length; i++){
		var oRoot = aRoots[i];
		if(oRoot.inherits("DzCamera") || oRoot.inherits("DzLight")){
			print("Skipping (camera/light):", oRoot.getLabel());
			continue;
		}
		dthScanFigureInto(oRoot, oAcc);
	}
}

/**
 * Which generation a scene's finds belong to: the first figure root whose stock
 * asset resolves. Clothing has no generation of its own — it is fitted to the
 * figure, and the studio only ever offers a character its OWN generation's
 * index, so filing the scene's extras under the figure's generation is what
 * makes them reachable. '' when the scene holds no Genesis figure at all.
 */
function dthSceneGenesis(){
	var aFigures = dthSceneFigureRoots();
	for(var i = 0; i < aFigures.length; i++){
		var sGenesis = dthDetectGenesis(aFigures[i]);
		if(sGenesis) return sGenesis;
	}
	return "";
}

/**
 * Merge this scene's new morphs into the stored scene index and write it back.
 *
 * A RE-scan of the same scene REPLACES that scene's contribution rather than
 * adding to it: the scene is first stripped out of every stored entry (an entry
 * left with no scenes is dropped), then the fresh finds are merged in. Without
 * that, clothing removed from a scene would haunt its autocomplete forever.
 * Entries found in several scenes carry all of them.
 */
function dthWriteSceneIndex(sOutDir, sGenesis, aNew, sScenePath, sSceneName){
	var sPath = dthSceneIndexPath(sOutDir, sGenesis);
	var sKey = dthSceneKey(sScenePath);
	var oStored = dthReadJson(sPath);
	var aMorphs = [];
	var oByKey = {};
	var i, j;

	// Carry the stored entries over, minus this scene's own past contribution.
	if(oStored && oStored.morphs){
		for(i = 0; i < oStored.morphs.length; i++){
			var oM = oStored.morphs[i];
			if(!oM || !oM.node || !oM.name) continue;
			var aScenes = [];
			var aWas = oM.scenes ? oM.scenes : [];
			for(j = 0; j < aWas.length; j++){
				if(dthSceneKey(aWas[j]) != sKey) aScenes.push(String(aWas[j]));
			}
			// Only this scene had it, and this scan no longer does — drop it.
			if(!aScenes.length) continue;
			var oCarry = {
				node: String(oM.node),
				nodeLabel: oM.nodeLabel ? String(oM.nodeLabel) : String(oM.node),
				label: oM.label ? String(oM.label) : String(oM.name),
				name: String(oM.name),
				scenes: aScenes
			};
			aMorphs.push(oCarry);
			oByKey[oCarry.node + "|" + oCarry.name] = oCarry;
		}
	}

	// Merge this scan's finds in: a known dial gains the scene, a new one joins.
	for(i = 0; i < aNew.length; i++){
		var oFound = aNew[i];
		var sMKey = oFound.node + "|" + oFound.name;
		var oExisting = oByKey[sMKey];
		if(oExisting){
			oExisting.scenes.push(sScenePath);
			continue;
		}
		var oEntry = {
			node: oFound.node,
			nodeLabel: oFound.nodeLabel,
			label: oFound.label,
			name: oFound.name,
			scenes: [sScenePath]
		};
		aMorphs.push(oEntry);
		oByKey[sMKey] = oEntry;
	}

	// The scene roster, same replace-this-scene rule as the entries above.
	var aScenesOut = [];
	if(oStored && oStored.scenes){
		for(i = 0; i < oStored.scenes.length; i++){
			var oS = oStored.scenes[i];
			if(oS && oS.path && dthSceneKey(oS.path) != sKey) aScenesOut.push(oS);
		}
	}
	aScenesOut.push({ path: sScenePath, name: sSceneName, scannedAt: new Date().toString() });

	var oOut = {
		version: 1,
		genesis: sGenesis,
		scannedAt: new Date().toString(),
		scenes: aScenesOut,
		morphs: aMorphs
	};
	var oFile = new DzFile(sPath);
	// One ORed mode arg - a second open() argument warns on DS6.
	if(oFile.open(oFile.WriteOnly | oFile.Truncate)){
		oFile.write(JSON.stringify(oOut, null, 1));
		oFile.close();
		print("Wrote", aMorphs.length, "scene morphs (", aNew.length, "from this scene ) to", sPath);
		return true;
	}
	print("Could not write the scene morph index:", sPath);
	return false;
}

/**
 * Scan the OPEN scene for morphs the base index doesn't have, and file them
 * under that scene. config: { outDir, bulk }
 *
 * Requires a SAVED scene — the whole point is to tag the finds with a scene the
 * studio can match its selection against, and an unsaved scene has no identity
 * to tag them with. Requires a base index too: without one every dial the stock
 * figure carries would be filed as a scene extra, which is exactly the noise
 * this mode exists to avoid. Both are hard failures (a `throw` under the Runner,
 * so the row is marked failed and the studio reports why).
 */
function DthScanSceneMorphs(config){
	var bBulk = config["bulk"] === true;
	var sOutDir = config["outDir"];

	var sScenePath = "";
	try { sScenePath = String(Scene.getFilename()); } catch(e){ /* unsaved */ }
	if(!sScenePath){
		var sUnsaved = "This scene has not been saved yet, so its morphs cannot be " +
			"filed under a scene name. Save the scene and run this again.";
		if(bBulk) throw new Error(sUnsaved);
		MessageBox.information(sUnsaved, "DTH Character Studio", "&OK");
		return;
	}
	var sSceneName = "";
	try { sSceneName = String(new DzFileInfo(sScenePath).completeBaseName()); } catch(e){ /* keep '' */ }

	var sGenesis = dthSceneGenesis();
	if(!sGenesis){
		var sNoFigure = "No Genesis 3, 8, 8.1 or 9 figure could be found in this scene, " +
			"so there is no generation to file its morphs under.";
		if(bBulk) throw new Error(sNoFigure);
		MessageBox.information(sNoFigure, "DTH Character Studio", "&OK");
		return;
	}
	print("Scene scan:", sSceneName, "(" + sScenePath + ") as", sGenesis);

	// Everything in the scene, then everything the base index already knows
	// filtered back out — what is left is what this scene ADDS.
	var oAcc = dthNewIndexAcc();
	dthScanWholeSceneInto(oAcc);
	var oBase = dthBaseIndexKeys(sOutDir, sGenesis);
	var aNew = [];
	for(var i = 0; i < oAcc.morphs.length; i++){
		var oM = oAcc.morphs[i];
		if(oBase[oM.node + "|" + oM.name]) continue;
		aNew.push(oM);
	}
	print("Scanned", oAcc.morphs.length, "morphs,", aNew.length, "of them new to the index.");

	var bOk = dthWriteSceneIndex(sOutDir, sGenesis, aNew, sScenePath, sSceneName);
	var sMsg = bOk
		? "Scanned “" + sSceneName + "”: " + aNew.length + " morph(s) this scene adds on " +
			"top of the " + dthGenesisLabel(sGenesis) + " base index.\n\nThe Morph name " +
			"autocomplete offers them while this scene is selected."
		: "Could not write the scene morph index (" + sOutDir + ").";
	if(bBulk){
		print("DTH Scan Scene Morphs:\n" + sMsg);
		// A write that failed must fail the ROW — never toast as success.
		if(!bOk) throw new Error("Could not write the scene morph index: " +
			dthSceneIndexPath(sOutDir, sGenesis));
		return;
	}
	MessageBox.information(sMsg, "DTH Character Studio", "&OK");
}

/**********************************************************************
 * The whole job. config: { outDir, scriptDir, bulk }
 *
 * bulk: true = running unattended under the Runner plugin (the studio's
 * Tools -> Build Genesis Index handoff). Daz is often minimized there, so a
 * modal dialog is an invisible dead stop for the whole batch: every dialog on
 * this path is replaced - questions resolve to their build-the-stock-figures
 * default, the summary goes to the log, and "nothing to build" throws so the
 * Runner marks the row failed and the studio toasts the reason.
 */
function DthBuildGenesisIndex(config){
	var bBulk = config["bulk"] === true;
	var aPlan = dthGenesisBuildPlan();
	var oByGen = {};
	var oReport = null;
	var iUnknown = 0;
	var g, f;

	// Scanning the OPEN scene is the escape hatch for everything the stock
	// figures don't carry (third-party geografts, add-ons, fitted clothing), so
	// offer it whenever the scene already holds figures - and never clear a
	// scene the user hasn't agreed to lose. Never asked in bulk: the Runner
	// hands this script a NEW EMPTY scene (the job row's empty scenePath), so
	// there is nothing to offer - and nobody watching to answer.
	var bScanOpenScene = false;
	if(!bBulk && dthSceneFigureRoots().length > 0){
		bScanOpenScene = MessageBox.question(
			"The open scene already has figures in it.\n\n" +
			"Scan THOSE figures (keeps everything they wear - third-party " +
			"geografts, add-ons, fitted clothing - in the index), or build the " +
			"stock figures for every generation from scratch?\n\n" +
			"Building replaces the open scene.",
			"DTH Character Studio",
			"&Scan open scene", "&Build stock figures") == 0;
	}

	// The SECOND mode (runtime v53): file the open scene's extras under that
	// SCENE instead of merging them into the base index. Only offered for a SAVED
	// scene - the finds are tagged with the scene path, so an unsaved scene has
	// no identity to tag them with and only the base merge is possible.
	//
	// Two chained 2-button questions rather than one 3-button dialog: two buttons
	// is the only MessageBox.question arity this runtime has ever used against a
	// real Daz, and a scan mode is not the place to find out the hard way.
	if(bScanOpenScene){
		var sOpenScene = "";
		try { sOpenScene = String(Scene.getFilename()); } catch(e){ /* unsaved */ }
		if(sOpenScene){
			var bPerScene = MessageBox.question(
				"How should these be indexed?\n\n" +
				"FOR THIS SCENE - what the scene wears (clothing, hair, add-ons) is " +
				"filed under it, and the studio only suggests those morphs while " +
				"this scene is selected. Best for outfit and look variants.\n\n" +
				"INTO THE BASE INDEX - the finds join the generation's index and are " +
				"suggested everywhere. Best for a figure or geograft the stock build " +
				"doesn't cover.",
				"DTH Character Studio",
				"&For this scene", "&Into the base index") == 0;
			if(bPerScene){
				DthScanSceneMorphs({ outDir: config["outDir"] });
				return;
			}
		}
		iUnknown = dthScanSceneInto(oByGen);
	} else {
		var aRoots = dthContentRoots(config["scriptDir"]);
		print("Content roots:", aRoots.join(" | "));
		oReport = dthResolvePlan(aPlan, aRoots);

		// Nothing installed that this can build: say so and leave the scene alone.
		// In bulk, throw instead - the Runner marks the row failed with the
		// message, which is how the studio's finish toast learns the reason.
		if(!oReport.buildable.length){
			var sNothing = "No Genesis 3, 8, 8.1 or 9 figure could be found in your " +
				"Daz content, so there is nothing to build.";
			if(bBulk){
				print("DTH Build Genesis Index:", sNothing);
				throw new Error(sNothing);
			}
			MessageBox.information(
				sNothing + "\n\nThe open scene was left " +
				"untouched. Install a Genesis figure, or load the figures you want " +
				"indexed into the scene and run this again to scan those.",
				"DTH Character Studio", "&OK");
			return;
		}

		var sPlanMsg = "This builds the morph + bone index from the figures you " +
			"have installed:\n\n";
		for(g = 0; g < oReport.buildable.length; g++){
			var oB = oReport.buildable[g];
			var aWhat = [];
			for(f = 0; f < oB.ready.length; f++) aWhat.push(dthFigureBuildLabel(oB.ready[f]));
			sPlanMsg += "  " + dthGenesisLabel(oB.genesis) + " - " + aWhat.join(", ") + "\n";
		}
		if(oReport.skippedGenesis.length)
			sPlanMsg += "\nNot installed, skipped: " + oReport.skippedGenesis.join(", ") + "\n";
		if(oReport.missingGrafts.length)
			sPlanMsg += "\nGeograft not installed, skipped: " +
				oReport.missingGrafts.join(", ") + "\n";
		sPlanMsg += "\nIt loads them a generation at a time and CLEARS THE SCENE " +
			"between each - and leaves it empty when it is done - so save your " +
			"work first. This takes a few minutes.";

		// The bulk scene is the Runner's own empty one - nothing to lose, nobody
		// in front of the window: log the plan and go.
		if(bBulk){
			print("DTH Build Genesis Index:\n" + sPlanMsg);
		} else if(MessageBox.question(sPlanMsg, "DTH Character Studio",
			"&Build the index", "&Cancel") != 0) return;

		// One step per generation, plus the final clear-down below.
		var oProgress = dthProgressStart("Building the DTH Genesis index...",
			oReport.buildable.length + 1);
		for(g = 0; g < oReport.buildable.length; g++){
			var oGen = oReport.buildable[g];
			dthProgressStep(oProgress, dthGenesisLabel(oGen.genesis) + "...");
			dthClearScene();
			for(f = 0; f < oGen.ready.length; f++){
				var oSpec = oGen.ready[f];
				var oFigure = dthLoadFigure(oSpec.asset);
				if(!oFigure){
					// Resolved but wouldn't load (a corrupt/partial install) —
					// report it exactly like a missing one rather than dying.
					oReport.skippedFigures.push(oSpec.label);
					continue;
				}
				if(oSpec.graftAsset && !dthLoadGraft(oSpec.graftAsset, oFigure))
					oReport.missingGrafts.push(oSpec.graft.name);
			}
			iUnknown += dthScanSceneInto(oByGen, oGen.genesis);
		}
		// Everything is scanned into oByGen by now, so the last generation's
		// figures have no further use — clear them too rather than dumping the
		// user back into a scene full of stock figures they never asked for.
		// Only ever on the BUILD path — it already cleared the scene once with
		// the user's consent. The open-scene branch is the user's OWN scene and
		// must be left exactly as it was found.
		dthProgressStep(oProgress, "Clearing the scene...");
		dthClearScene();
		dthProgressFinish(oProgress);
	}

	// One file per generation that produced anything.
	var aWritten = [];
	var aFailed = [];
	var aGenesis = ["G3", "G8", "G8.1", "G9"];
	for(g = 0; g < aGenesis.length; g++){
		var oAcc = oByGen[aGenesis[g]];
		if(!oAcc) continue;
		if(dthWriteIndex(config["outDir"], aGenesis[g], oAcc))
			aWritten.push(dthGenesisLabel(aGenesis[g]) + ": " + oAcc.morphs.length +
				" morphs, " + oAcc.bones.length + " bones");
		else
			aFailed.push(dthGenesisLabel(aGenesis[g]));
	}

	var sMsg;
	if(aWritten.length){
		sMsg = "Indexed:\n\n" + aWritten.join("\n") +
			"\n\nThe Morph name and bone autocompletes in DTH Character Studio now know them.";
	} else {
		sMsg = "Nothing was indexed - no Genesis figure could be built or found in the scene.";
	}
	// A skipped generation leaves its EXISTING index alone rather than replacing
	// it with nothing, so say that plainly - an uninstalled generation must not
	// read as "your old index was wiped".
	if(oReport){
		if(oReport.grafts.length)
			sMsg += "\n\nGeografts loaded:\n" + oReport.grafts.join("\n");
		if(oReport.skippedGenesis.length)
			sMsg += "\n\nNot installed, skipped (any existing index for them is " +
				"untouched): " + oReport.skippedGenesis.join(", ") + ".";
		if(oReport.missingGrafts.length)
			sMsg += "\n\nGeograft not installed, skipped: " +
				oReport.missingGrafts.join(", ") + ".";
		if(oReport.skippedFigures.length)
			sMsg += "\n\nFigures skipped: " + oReport.skippedFigures.join(", ") + ".";
	}
	if(iUnknown)
		sMsg += "\n\n" + iUnknown + " figure(s) in the scene were not a Genesis 3/8/8.1/9 " +
			"figure and were skipped.";
	if(aFailed.length)
		sMsg += "\n\nCould not write the index for: " + aFailed.join(", ") +
			"\n(" + config["outDir"] + ")";
	// Bulk: the studio's panel reports the outcome; a modal here would hold the
	// row below done forever inside a Daz nobody is looking at. An index that
	// could not be WRITTEN still fails the row - that outcome must not toast
	// as success.
	if(bBulk){
		print("DTH Build Genesis Index:\n" + sMsg);
		if(aFailed.length) throw new Error(
			"Could not write the index for: " + aFailed.join(", ") + " (" + config["outDir"] + ")");
		return;
	}
	MessageBox.information(sMsg, "DTH Character Studio", "&OK");
}
