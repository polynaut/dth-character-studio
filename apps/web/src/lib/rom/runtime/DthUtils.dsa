// DAZ Studio version 4.22.0.16 filetype DAZ Script

//include("./util.dsa");

var DTH_VERBOSE = false;
var EPSILON = .0001;

function verbose(){
	if( DTH_VERBOSE ){
		print.apply(this, arguments);
	}
}

/**********************************************************************
 * ROM run log — collects every problem of a run (a morph that couldn't be
 * applied, a preset that failed to load, any unexpected error) so the run can
 * finish drift-free and the studio can show exactly what failed afterwards.
 * Written as JSON by writeRunLog (path baked into the generated script).
 *
 * FOUR channels, and the split is a CONTRACT, not tidiness:
 *
 *   errors       - this ROM is not fit to export. Counted by runLogProblemCount,
 *                  so ApplyDTHCharacter returns false and the generated script's
 *                  export gate skips the export.
 *   warnings     - something to SHOW, that does not condemn the ROM. NOT
 *                  counted, so the export still runs. Anything filed here must
 *                  be defensible as "the exported artifacts are still correct".
 *   failedMorphs - one dial that could not be applied; its frame stays, empty.
 *   keyProblems  - the individual keys the interpolation pass could not fix,
 *                  named well enough to go and look at them (runtime v79).
 *                  Capped per kind; the message says how many were left out.
 *
 * The warnings channel exists because a run that reported 4 bad keys out of 7968
 * used to block a character's entire Houdini side, and the user saw a row marked
 * "done" with no export and no reason unless they opened the Daz log. */
var DTH_RUN_LOG = { errors: [], warnings: [], failedMorphs: [], keyProblems: [] };

function resetRunLog(){
	DTH_RUN_LOG = { errors: [], warnings: [], failedMorphs: [], keyProblems: [] };
}

/** A general problem (preset failed, node missing, unexpected error, …).
 *  BLOCKS the export — see the channel contract above. */
function logRunError(sMessage){
	DTH_RUN_LOG.errors.push(String(sMessage));
	print("ERROR:", sMessage);
}

/** A problem worth showing that does NOT block the export. The studio surfaces
 *  it beside the errors; the export runs. Use this only where the exported
 *  artifacts are still correct — if in doubt it is an error. */
function logRunWarning(sMessage){
	DTH_RUN_LOG.warnings.push(String(sMessage));
	print("WARNING:", sMessage);
}

/** How many of each kind of key problem get NAMED. A ROM carries ~8000 keys and
 *  a pathological run could name every one of them, flooding both the Daz log
 *  and the studio's report — so each kind gets its own budget (per kind, not one
 *  shared pool: 5000 of one kind must not squeeze out the 4 of another, which is
 *  exactly the interesting case). The counts are always exact. */
var DTH_KEY_PROBLEM_CAP = 8;

/** File one named key problem, if its kind still has budget. `oCounts` is the
 *  caller's per-kind tally (total seen, not total named). Returns the entry when
 *  it was recorded, null when the cap swallowed it. */
function logRunKeyProblem(oCounts, oEntry){
	var sKind = oEntry.kind;
	if(oCounts[sKind] === undefined) oCounts[sKind] = 0;
	oCounts[sKind]++;
	if(oCounts[sKind] > DTH_KEY_PROBLEM_CAP) return null;
	DTH_RUN_LOG.keyProblems.push(oEntry);
	return oEntry;
}

/** One morph/property that couldn't be applied — the frame slot stays, only
 *  this morph is missing, and the studio lists it after the run. */
function logRunFailedMorph(iFrame, sNode, sProp, sReason){
	DTH_RUN_LOG.failedMorphs.push({
		frame: iFrame, node: String(sNode), prop: String(sProp), reason: String(sReason)
	});
	print("FAILED MORPH: frame", iFrame, "-", sNode, "/", sProp, "-", sReason);
}

/** What makes a run NOT ok: errors and failed morphs. Warnings and key problems
 *  are deliberately absent — they are reported, not fatal (see the contract
 *  above), and counting them here would put the export gate back where it was. */
function runLogProblemCount(){
	return DTH_RUN_LOG.errors.length + DTH_RUN_LOG.failedMorphs.length;
}

/**********************************************************************
 * Interrupt — "stop this run at the next point where stopping is safe".
 *
 * A ROM build is the long pole of a DTH Export: minutes to an hour per scene,
 * inside a Daz Studio nobody is watching, driven by a plugin the studio cannot
 * talk to. So the studio drops a FLAG FILE (its path baked into the generated
 * script's config as `cancelPath`) and this runtime polls it at every block
 * boundary and inside the frame-apply loop. The build then stops with the
 * scene coherent — no export follows, and the run log says why.
 *
 * STICKY on purpose: once seen, the flag stays seen for the rest of the run
 * (`DTH_CANCELLED`), so a studio that deletes it the moment the run ends can
 * never leave half a build thinking it should carry on.
 *
 * THROTTLED on purpose too: the flag lives in the project folder, which may sit
 * on a network drive, and the frame loop asks thousands of times. One stat per
 * DTH_CANCEL_POLL_MS is plenty — the user is waiting on a build measured in
 * minutes, not on a sub-second reaction.
 */
var DTH_CANCEL_PATH = "";
var DTH_CANCELLED = false;
var DTH_CANCEL_CHECKED_MS = 0;
var DTH_CANCEL_POLL_MS = 750;

/** Arm (or disarm, with an empty path) the interrupt probe for one run. */
function dthArmCancel(sPath){
	DTH_CANCEL_PATH = sPath ? String(sPath) : "";
	DTH_CANCELLED = false;
	DTH_CANCEL_CHECKED_MS = 0;
}

/** Has the studio asked this run to stop? Best-effort: a flag that cannot be
 *  read reads as "no". The dangerous answer is the false positive — it would
 *  abandon a build nobody asked to stop. */
function dthStopRequested(){
	if(DTH_CANCELLED) return true;
	if(!DTH_CANCEL_PATH) return false;
	try {
		var iNow = new Date().getTime();
		if(iNow - DTH_CANCEL_CHECKED_MS < DTH_CANCEL_POLL_MS) return false;
		DTH_CANCEL_CHECKED_MS = iNow;
		if(new DzFile(DTH_CANCEL_PATH).exists()){
			DTH_CANCELLED = true;
			print("DTH Character Studio: stop requested - the ROM build will stop at the next safe point.");
		}
	} catch(e){ /* can't tell - keep working */ }
	return DTH_CANCELLED;
}

/** Whether THIS run was stopped — read after the fact (it never re-probes), so
 *  the reporting cannot disagree with the decision the build already made. */
function dthWasInterrupted(){
	return DTH_CANCELLED;
}

/** The scene-path convention shared with the studio (normalizeSceneKey in
 *  execute-jobs.ts): trimmed, '/'-separators, lowercased. It is what a stored
 *  run is matched by, so both sides must agree. */
function dthRunLogSceneKey(sPath){
	return String(sPath).replace(/^\s+|\s+$/g, "").replace(/\\/g, "/").toLowerCase();
}

/** The runs already in the log at sPath, as an array. Tolerates a v1 log (ONE
 *  run as the top-level object) by wrapping it, and anything unreadable by
 *  starting fresh — a broken log must never cost the run that is finishing. */
function dthReadRunLogRuns(sPath){
	try {
		var oFile = new DzFile(sPath);
		if(!oFile.open(oFile.ReadOnly)) return [];
		var sText = String(oFile.read());
		oFile.close();
		var oPrev = JSON.parse(sText);
		if(!oPrev) return [];
		if(oPrev.runs && oPrev.runs.length !== undefined) return oPrev.runs;
		// A v1 log: the run IS the top-level object. It predates scene tagging,
		// so it can only be matched by "has no scene" — the merge below drops it
		// whenever this run has one, which is right: the same character folder,
		// one run per scene from now on.
		if(oPrev.failedMorphs || oPrev.errors) return [oPrev];
	} catch(e){ /* unreadable/torn — start fresh */ }
	return [];
}

/**
 * Write the run log JSON to sPath. oSummary carries the run metadata
 * (character, versions, frame counts, ok) baked in by the caller.
 *
 * MERGES BY SCENE (log v2). A DTH Export batch runs one row per scene back to
 * back inside a Daz nobody is watching, and every row writes THIS file — so a
 * plain truncate meant only the last scene's problems ever reached the studio,
 * and the two scenes that failed before it were destroyed silently. Each run is
 * now stored under the scene it ran in; a re-run of the same scene REPLACES its
 * own entry (stale failures must not linger) and leaves every other scene's
 * alone. Same read-modify-write shape as the scene morph index.
 */
function writeRunLog(sPath, oSummary){
	if(!sPath) return false;
	var oRun = oSummary || {};
	oRun.finishedAt = new Date().toString();
	oRun.finishedAtMs = new Date().getTime();
	oRun.errors = DTH_RUN_LOG.errors;
	oRun.warnings = DTH_RUN_LOG.warnings;
	oRun.failedMorphs = DTH_RUN_LOG.failedMorphs;
	oRun.keyProblems = DTH_RUN_LOG.keyProblems;
	// Which scene produced this run — without it the studio cannot attribute a
	// failure to a scene, let alone select it. '' for an unsaved scene.
	var sScene = "";
	try { sScene = String(Scene.getFilename()); } catch(e){ /* unsaved */ }
	oRun.scene = sScene;
	oRun.sceneName = "";
	if(sScene){
		try { oRun.sceneName = String(new DzFileInfo(sScene).completeBaseName()); } catch(e){ /* keep '' */ }
	}

	var aRuns = dthReadRunLogRuns(sPath);
	var aKeep = [];
	var sKey = dthRunLogSceneKey(sScene);
	for(var i = 0; i < aRuns.length; i++){
		var oOld = aRuns[i];
		if(!oOld) continue;
		// Replace THIS scene's previous entry (and any untagged v1 leftover).
		if(dthRunLogSceneKey(oOld.scene ? oOld.scene : "") == sKey) continue;
		aKeep.push(oOld);
	}
	aKeep.push(oRun);

	var oLog = {
		logVersion: 2,
		// Whole-batch verdict: the studio shows the report unless EVERY scene of
		// the batch came back clean.
		ok: true,
		finishedAt: oRun.finishedAt,
		finishedAtMs: oRun.finishedAtMs,
		character: oRun.character ? oRun.character : "",
		runs: aKeep
	};
	for(var r = 0; r < aKeep.length; r++){
		if(aKeep[r] && aKeep[r].ok !== true) oLog.ok = false;
	}
	try {
		var oFile = new DzFile(sPath);
		// One ORed mode arg — DzFile.open(mode) takes a single flags int; a second
		// argument was silently ignored on DS4 but warns on DS6 ("Too many arguments").
		if(oFile.open(oFile.WriteOnly | oFile.Truncate)){
			oFile.write(JSON.stringify(oLog, null, 2));
			oFile.close();
			print("Run log written to", sPath, "(" + aKeep.length + " scene run(s))");
			return true;
		}
		print("Could not open run log for writing:", sPath);
	} catch(e) {
		print("Failed writing run log:", e);
	}
	return false;
}
/**********************************************************************
 * Stamp every ROM morph key LINEAR — on DS4 AND DS6. The runtime-v17 DS6
 * special case (Constant keys, a workaround for DS6 drifting Linear ROM keys)
 * is ROLLED BACK (runtime v35): it didn't actually solve the drift and caused
 * headaches with the DK9 ROM, and mrpdean is rolling the same workaround out
 * of the next DTH release (July 2026).
 *
 * MEASURED 2026-08-16 — DS 4.24, runtime v76, scene.animations read straight
 * out of a shipped LaraCroft_G81_THICK_ROM.duf. Three facts, and this pass is
 * the answer to all three:
 *
 *  1. 230 of its 292 morph channels serialized CONSTANT, 62 LINEAR. That split
 *     is NOT two kinds of morph: the CONSTANT ones are exactly the channels the
 *     ROM PRESETS key (pCTRL*, CTRL*, facs_ctrl_*, facs_jnt_*, facs_bs_*), the
 *     LINEAR ones exactly the channels this runtime CREATES with setValue.
 *     Loading a pose preset carries the interpolation stored IN the preset, and
 *     mrpdean's ROM .duf files hold CONSTANT — so "loaded from a file" vs
 *     "created by a script" is the whole of it.
 *  2. The old pass was meant to erase that difference and did not. That run's
 *     Daz log shows it collecting 107 props, finishing without an error, and
 *     the scene saving after it — yet 43 of those 107 (the facs_bs_*
 *     blendshapes: morph modifiers on the figure's own geometry, squarely
 *     inside the old walk) still serialized CONSTANT. A setKeyInterpolationType
 *     that changes nothing and reports nothing is indistinguishable from a
 *     working one, so every stamp is now READ BACK, and a key that won't take
 *     the stamp is rewritten through setValue (which carries the interpolation
 *     as an argument). What could not be set is counted and logged.
 *  3. Every channel this runtime creates serialized its frame-0 entry as
 *     [0, value] with NO interpolation, while preset-loaded channels carry one.
 *     Daz writes that bare entry for a channel whose first REAL key sits later,
 *     and on load it falls back to whatever default interpolation the READER
 *     has. dthEnsureFrameZeroKey turns it into a real key — same value, same
 *     animation, but its interpolation is now written down.
 *
 * The old walk also skipped node properties WHOLESALE to protect the figure's
 * transforms, and every pCTRL / facs_ control dial lives exactly there — ~190
 * of the CONSTANT channels were never even looked at.
 *
 * EVERY animated channel is walked now, TRANSFORMS INCLUDED (bones too). The
 * same measurement found all 1298 transform channels of that file CONSTANT,
 * uniformly, from the same presets. The old "transforms should never be
 * touched" rule was about not MOVING them, and nothing here moves a value: a
 * stamp changes interpolation only, and the setValue fallback restores the
 * exact value it read. At the keyed pose frames CONSTANT and LINEAR give
 * identical values either way — what changes is the shape of the motion
 * BETWEEN pose frames. */

var DTH_LINEAR_INTERP;                 // resolved once, by dthLinearInterp()
var DTH_LINEAR_INTERP_DONE = false;

// The nudge a key's value takes and gives back, to make Daz rewrite the key
// (see dthStampKeyLinear). A value that will not move by this much in EITHER
// direction belongs to a locked or driven channel, which is reported, not
// retried.
var DTH_INTERP_NUDGE = 0.001;

/* What one key's stamp came to. Named rather than numbered, because the five
 * outcomes are NOT a severity scale — IMMOVABLE is usually harmless and
 * VALUE_LOST is the worst thing this pass can do, and a caller reading `-1`
 * would never guess which is which. */
var DTH_KEY_LINEAR     = "linear";      // reads back LINEAR - the only verified win
var DTH_KEY_UNVERIFIED = "unverified";  // rewritten, but this build cannot read interpolation back
var DTH_KEY_IMMOVABLE  = "immovable";   // the VALUE would not move, so Daz never rewrote the key
var DTH_KEY_FAILED     = "failed";      // the value moved and the key is still not LINEAR
var DTH_KEY_VALUE_LOST = "value-lost";  // the nudge could not be put back - the key's VALUE is wrong

/* What dthEnsureFrameZeroKey came to. Named for the same reason: "-1" covered
 * three outcomes that want three different sentences, and the caller could only
 * report the count of all of them. */
var DTH_ZERO_ADDED       = "added";        // a real key now sits at frame 0
var DTH_ZERO_PRESENT     = "present";      // one was already there (or the channel isn't animated)
var DTH_ZERO_DRIVEN      = "driven";       // ERC-driven: frame 0 is not ours to write
var DTH_ZERO_REFUSED     = "refused";      // no key could be made there
var DTH_ZERO_ROLLED_BACK = "rolled-back";  // added, moved the value, taken away again

/**********************************************************************
 * Value -> name for the interpolation enum, so a key that reads back `1` can be
 * REPORTED as CONSTANT rather than as a number nobody can act on.
 *
 * Only spellings this build actually defines are used, and only ones measured to
 * exist (DS 4.24: DzFloatProperty.LINEAR_INTERP / CONSTANT_INTERP / TCB_INTERP =
 * 0 / 1 / 2, DzProperty.InterpLinear / InterpConstant). A value with no name
 * known here is printed bare — a guessed name would be worse than a number. */
var DTH_INTERP_NAMES = null;
function dthInterpName(iValue){
	if(iValue === undefined || iValue === null) return "";
	if(!DTH_INTERP_NAMES){
		DTH_INTERP_NAMES = {};
		var aNamed = [];
		if(typeof DzFloatProperty != "undefined"){
			aNamed.push(["LINEAR", DzFloatProperty.LINEAR_INTERP]);
			aNamed.push(["CONSTANT", DzFloatProperty.CONSTANT_INTERP]);
			aNamed.push(["TCB", DzFloatProperty.TCB_INTERP]);
		}
		if(typeof DzProperty != "undefined"){
			aNamed.push(["LINEAR", DzProperty.InterpLinear]);
			aNamed.push(["CONSTANT", DzProperty.InterpConstant]);
		}
		for(var i = 0; i < aNamed.length; i++){
			if(aNamed[i][1] === undefined || aNamed[i][1] === null) continue;
			if(DTH_INTERP_NAMES[aNamed[i][1]] === undefined) DTH_INTERP_NAMES[aNamed[i][1]] = aNamed[i][0];
		}
	}
	var sName = DTH_INTERP_NAMES[iValue];
	return sName ? (sName + " (" + iValue + ")") : String(iValue);
}

/** A key's time as a FRAME, which is the only unit anyone reading this report
 *  thinks in. -1 when the scene won't say what a frame is worth. */
function dthFrameOfTime(tTime){
	try {
		var iStep = Scene.getTimeStep();
		if(!iStep) return -1;
		return Math.round(tTime / iStep);
	} catch(e){ return -1; }
}

/** The node's place in the scene tree ("Genesis8_1Female/hip/abdomenLower/…"),
 *  because a bare property name cannot say which of ninety bones it sits on.
 *  Guarded against a cycle it should never meet. */
function dthNodePath(oNode){
	var aParts = [];
	var oCur = oNode;
	var iGuard = 0;
	while(oCur && iGuard++ < 64){
		aParts.unshift(String(oCur.getName()));
		oCur = (typeof oCur.getNodeParent == "function") ? oCur.getNodeParent() : null;
	}
	return aParts.join("/");
}

/**********************************************************************
 * ONE key the interpolation pass could not fix, named. This is what the counts
 * were missing: a run reporting "4 of 7968 key(s) would not read back LINEAR"
 * gave nobody a single thing to go and look at.
 *
 * `iKey` is -1 for a whole-channel problem (frame 0 has no key to index).
 * `iRead` is the interpolation Daz reports for the key AFTER the pass — the
 * evidence, on builds that can be asked; undefined on the ones that can't. */
function dthKeyProblemEntry(sKind, oChan, iKey, tTime, iRead, sReason){
	var oProp = oChan.prop;
	var oEntry = {
		kind: sKind,
		node: oChan.node,
		prop: String(oProp.getName()),
		key: iKey,
		// How many keys the CHANNEL holds. Without it a report cannot answer the
		// first question anyone asks of a bad key — does its interpolation span
		// anything at all? — and the first real report could not: four findings
		// on channels holding one key each, which is nothing, read as four
		// broken keys.
		keys: oProp.getNumKeys(),
		frame: dthFrameOfTime(tTime),
		interp: dthInterpName(iRead),
		reason: sReason
	};
	var sLabel = String(oProp.getLabel());
	if(sLabel && sLabel != oEntry.prop) oEntry.propLabel = sLabel;
	// The dial's group path in the Parameters pane, when this build offers it —
	// it is how a human finds the channel in the UI.
	try {
		if(typeof oProp.getPath == "function"){
			var sPath = String(oProp.getPath());
			if(sPath) oEntry.path = sPath;
		}
	} catch(e){ /* no path on this build - the node/property pair still identifies it */ }
	return oEntry;
}

/** One key problem as a line for the Daz log. */
function dthKeyProblemLine(oEntry){
	var s = oEntry.node + " / " + oEntry.prop;
	if(oEntry.propLabel) s += " (" + oEntry.propLabel + ")";
	if(oEntry.path) s += " [" + oEntry.path + "]";
	if(oEntry.key >= 0) s += " - key " + oEntry.key + " of " + oEntry.keys;
	s += " at frame " + (oEntry.frame < 0 ? "?" : oEntry.frame);
	if(oEntry.interp) s += ", reads back " + oEntry.interp;
	return s;
}

/** "(Foo / bar at frame 12; Baz / qux at frame 40; and 3 more.)" — the named
 *  sample that goes INSIDE a run-log message, so the studio's one-line report
 *  points at something even before the user opens the detail list. */
function dthKeyProblemSample(aEntries, iTotal){
	if(aEntries.length < 1) return "";
	var aShort = [];
	for(var i = 0; i < aEntries.length && i < 3; i++){
		aShort.push(aEntries[i].node + " / " + aEntries[i].prop +
			" at frame " + (aEntries[i].frame < 0 ? "?" : aEntries[i].frame));
	}
	var s = " (" + aShort.join("; ");
	if(iTotal > aShort.length) s += "; and " + (iTotal - aShort.length) + " more";
	return s + ".)";
}

/**********************************************************************
 * The LINEAR interpolation constant of the RUNNING Daz. The API reference
 * spells this enum two ways — DzFloatProperty documents LINEAR_INTERP,
 * DzProperty documents InterpLinear — and a name a build does NOT define reads
 * back as `undefined`, which is enough to turn setKeyInterpolationType into a
 * silent no-op (fact 2 above looks exactly like that). So: take the first
 * spelling this build actually has, and print which one it was, because the
 * next person debugging ROM interpolation should not have to guess. */
function dthLinearInterp(){
	if(DTH_LINEAR_INTERP_DONE) return DTH_LINEAR_INTERP;
	DTH_LINEAR_INTERP_DONE = true;
	var aTry = [];
	if(typeof DzFloatProperty != "undefined"){
		aTry.push(["DzFloatProperty.LINEAR_INTERP", DzFloatProperty.LINEAR_INTERP]);
		aTry.push(["DzFloatProperty.InterpLinear", DzFloatProperty.InterpLinear]);
	}
	if(typeof DzProperty != "undefined"){
		aTry.push(["DzProperty.InterpLinear", DzProperty.InterpLinear]);
		aTry.push(["DzProperty.LINEAR_INTERP", DzProperty.LINEAR_INTERP]);
		aTry.push(["DzProperty.Linear", DzProperty.Linear]);
	}
	// Diagnostic: this is the constant the session default is set from, below
	// and in ApplyInitialValues. Undefined there means new keys fall back to
	// the user's Daz preference instead of Linear.
	print("Interpolation constants: DzProperty.Linear =",
		(typeof DzProperty != "undefined") ? DzProperty.Linear : "<no DzProperty>");
	for(var i = 0; i < aTry.length; i++){
		if(aTry[i][1] !== undefined && aTry[i][1] !== null){
			DTH_LINEAR_INTERP = aTry[i][1];
			print("Stamping keys with", aTry[i][0], "=", DTH_LINEAR_INTERP);
			return DTH_LINEAR_INTERP;
		}
	}
	logRunError("No LINEAR interpolation constant on DzFloatProperty/DzProperty in this Daz build - ROM keys keep whatever interpolation they were created with.");
	return undefined;
}

/** setValue, with the interpolation argument when this build gave us one. */
function dthSetValueInterp(oProp, tTime, fValue, iInterp){
	if(iInterp === undefined) oProp.setValue(tTime, fValue);
	else oProp.setValue(tTime, fValue, iInterp);
}

/** Collect `oProp` when it is animated and not already collected — WITH the node
 *  it belongs to, which is half of a key's identity when the pass has to report
 *  one it could not fix.
 *
 *  "Animated" here means `getNumKeys() >= 1`, which is WIDER than it sounds:
 *  Daz reports an implicit key at frame 0 for a channel nobody ever keyed (see
 *  the note above dthEnsureFrameZeroKey), so this collects plenty of channels
 *  that carry no animation at all — measured 2026-08-17, 2599 collected against
 *  1590 genuinely animated channels in the saved ROM of the same character. That
 *  is not a problem in itself (a stamp on a static channel is harmless), but it
 *  is exactly why a single key at frame 0 must never be REPORTED as a failure:
 *  see the spans-nothing rule in setLinearInterp. */
function dthPushInterpProp(aChannels, oSeen, sNodeKey, sNodePath, oProp){
	if(!oProp || typeof oProp.getNumKeys != "function") return;
	if(oProp.getNumKeys() < 1) return;
	var sKey = sNodeKey + "|" + String(oProp.getName());
	if(oSeen[sKey]) return;
	oSeen[sKey] = true;
	aChannels.push({ prop: oProp, node: sNodePath });
}

/**********************************************************************
 * Every animated float channel on `oNodes`: the morph modifiers on each node's
 * OBJECT (delta morphs, FACS blendshapes) AND the node's own channels — the
 * pCTRL / CTRL / facs_ctrl_ controllers the ROM presets key, which have no
 * modifier of their own and which the pre-v77 walk never saw, plus the
 * transform channels (see setLinearInterp: a ROM's bone keys arrive CONSTANT
 * from the presets too, and nothing here moves a value).
 *
 * Returns CHANNEL RECORDS ({ prop, node }), not bare properties: the node path
 * is resolved once here, per node, and carried along so a key that fails the
 * pass can be named without walking the tree again. */
function collectInterpChannels(oNodes){
	var aChannels = [];
	var oSeen = {};
	for(var x = 0; x < oNodes.length; x++){
		var oNode = oNodes[x];
		if(!oNode) continue;
		var sNodeKey = String(oNode.getName());
		var sNodePath = dthNodePath(oNode);
		var oObj = oNode.getObject();
		if(oObj){
			for(var i = 0; i < oObj.getNumModifiers(); i++){
				var oMod = oObj.getModifier(i);
				if(!oMod || !oMod.inherits("DzMorph")) continue;
				// getValueChannel first, getValueControl as the fallback — the
				// same pair resetFrameDatasAtFrame uses to survive both APIs.
				var oMorphProp = null;
				if(typeof oMod.getValueChannel == "function") oMorphProp = oMod.getValueChannel();
				if(!oMorphProp && typeof oMod.getValueControl == "function") oMorphProp = oMod.getValueControl();
				dthPushInterpProp(aChannels, oSeen, sNodeKey, sNodePath, oMorphProp);
			}
		}
		if(typeof oNode.getNumProperties != "function") continue;
		for(var p = 0; p < oNode.getNumProperties(); p++){
			var oNodeProp = oNode.getProperty(p);
			if(!oNodeProp || !oNodeProp.inherits("DzFloatProperty")) continue;
			dthPushInterpProp(aChannels, oSeen, sNodeKey, sNodePath, oNodeProp);
		}
	}
	return aChannels;
}

/**********************************************************************
 * Give a channel a REAL key at frame 0 (fact 3 above). Same value it already
 * holds there, so the animation is unchanged — only now the interpolation of
 * that key is written to the .duf instead of being left to the reader.
 *
 * setValue is a no-op when the value doesn't change, so the value is nudged off
 * and put back exactly; both directions, because a value sitting on a limit
 * clamps straight back to itself.
 *
 * An ERC-DRIVEN channel reads its controller's contribution back through
 * getValue, so keying it from getValue can DOUBLE-APPLY — this is the -10%
 * character height that read as -20% (see closeDanglingMorphKeys), and a wrong
 * value is far worse than an implicit key. A driven channel is therefore left
 * alone up front where the build can say so, and rolled back after the fact
 * where it can't.
 *
 * Returns one of the DTH_ZERO_* outcomes above. They used to be a single `-1`
 * covering three different things — driven, refused, and rolled back — which is
 * why the caller could only ever report a count. A rollback that does not fully
 * undo itself leaves a WRONG VALUE at frame 0 and logs a run-log error naming
 * the channel; it is still DTH_ZERO_ROLLED_BACK so the caller can tell it apart
 * from the benign "kept its implicit key" cases. */
function dthEnsureFrameZeroKey(oProp, iInterp){
	if(oProp.getNumKeys() < 1) return DTH_ZERO_PRESENT;
	if(oProp.getKeyTime(0) == 0) return DTH_ZERO_PRESENT;
	// Driven by an ERC link? Then its value at frame 0 is not ours to write.
	if(typeof oProp.getNumControllers == "function" && oProp.getNumControllers() > 0) return DTH_ZERO_DRIVEN;
	var iKeysBefore = oProp.getNumKeys();
	var fAt0 = oProp.getValue(0);
	var aNudge = [fAt0 + DTH_INTERP_NUDGE, fAt0 - DTH_INTERP_NUDGE];
	for(var n = 0; n < aNudge.length && oProp.getKeyTime(0) != 0; n++){
		dthSetValueInterp(oProp, 0, aNudge[n], iInterp);
		dthSetValueInterp(oProp, 0, fAt0, iInterp);
	}
	if(oProp.getKeyTime(0) != 0) return DTH_ZERO_REFUSED;
	if(approx_eq(oProp.getValue(0), fAt0)) return DTH_ZERO_ADDED;
	// The value moved: this build reported no controllers but behaves like a
	// driven channel. Drop the key again — [0,0] is the one key just added
	// whether deleteKeys reads its arguments as times or as indices. Every way
	// that rollback can fail leaves a WRONG VALUE at frame 0, so every one of
	// them is a run-log error naming the channel; none may pass as the benign
	// "kept its implicit key" case the caller reports.
	if(typeof oProp.deleteKeys != "function"){
		logRunError("Frame-0 key on " + oProp.getLabel() + " moved the channel's value to " +
			oProp.getValue(0) + " (expected " + fAt0 + ") and this Daz build has no deleteKeys to undo it - check this channel at frame 0.");
		return DTH_ZERO_ROLLED_BACK;
	}
	oProp.deleteKeys(0, 0);
	var iKeysAfter = oProp.getNumKeys();
	if(iKeysAfter > iKeysBefore){
		logRunError("Frame-0 key rollback on " + oProp.getLabel() + " removed nothing - the channel now holds " +
			oProp.getValue(0) + " at frame 0 instead of " + fAt0 + ".");
	} else if(iKeysAfter < iKeysBefore){
		logRunError("Frame-0 key rollback on " + oProp.getLabel() + " removed " +
			(iKeysBefore + 1 - iKeysAfter) + " key(s) instead of 1 - check this channel's animation.");
	}
	return DTH_ZERO_ROLLED_BACK;
}

/**********************************************************************
 * LINEAR for key `j`, VERIFIED. Returns one of the DTH_KEY_* outcomes above.
 *
 * A build with no getKeyInterpolationType gets DTH_KEY_UNVERIFIED, never
 * DTH_KEY_LINEAR: setKeyInterpolationType is measured to do NOTHING, so
 * "stamped it and could not read it back" would mean reporting a whole ROM
 * fixed while changing not one key. The setValue rewrite still runs there (it
 * is the mechanism that works), and the caller says plainly that it could not
 * be confirmed.
 *
 * MEASURED 2026-08-16 (DS 4.24), which is why this looks the way it does:
 *   - setKeyInterpolationType() changed NOTHING, in either overload, on any of
 *     7747 keys. It is still called first because it costs one call and may be
 *     the right route on another build - but it is never trusted.
 *   - setValue(t, v, LINEAR) DOES rewrite the key's interpolation: 1190 of 1500
 *     attempts. It is a no-op when the value doesn't change, hence the nudge,
 *     and the interpolation ARGUMENT is what lands (the session default alone
 *     changes nothing on an existing key).
 *   - The 310 that refused were all channels whose value cannot move: locked
 *     transforms (min == max == 0) and the hidden /Hidden/CTRLMDs ERC
 *     controllers, every one of them a SINGLE key at frame 0, where
 *     interpolation spans nothing. Hence DTH_KEY_IMMOVABLE - but that is what
 *     ONE scene held, so this function reports the fact and setLinearInterp
 *     decides, per channel, whether this scene agrees. An immovable key on a
 *     multi-key channel is a real failure and says so.
 *     Immovable is also never allowed to abort the pass for everything after
 *     it, which is exactly the bug that made runtime v77 report 5333 failures. */
function dthStampKeyLinear(oProp, j, iInterp){
	var bCanRead = (typeof oProp.getKeyInterpolationType == "function");
	if(typeof oProp.setKeyInterpolationType == "function") oProp.setKeyInterpolationType(j, iInterp);
	if(bCanRead && oProp.getKeyInterpolationType(j) == iInterp) return DTH_KEY_LINEAR;
	// Rewrite the key through setValue, which carries the interpolation as an
	// argument: nudge the value off and put it back EXACTLY. Both directions,
	// because a value sitting on a limit clamps straight back to itself.
	var tKey = oProp.getKeyTime(j);
	var fValue = oProp.getKeyValue(j);
	var aNudge = [fValue + DTH_INTERP_NUDGE, fValue - DTH_INTERP_NUDGE];
	var bValueMoved = false;
	for(var n = 0; n < aNudge.length; n++){
		dthSetValueInterp(oProp, tKey, aNudge[n], iInterp);
		if(!approx_eq(oProp.getKeyValue(j), fValue)) bValueMoved = true;
		dthSetValueInterp(oProp, tKey, fValue, iInterp);
		// Blind build: the rewrite is all there is, and a value that moved is
		// the only evidence it happened. One direction is enough.
		if(bValueMoved && !bCanRead) break;
		if(bCanRead && oProp.getKeyInterpolationType(j) == iInterp) break;
	}
	// The VALUE is what must survive this pass. A key left sitting a nudge off
	// its own value is worse than a key with the wrong interpolation, so the
	// restore is retried AND read back, and it outranks every other outcome.
	if(!approx_eq(oProp.getKeyValue(j), fValue)){
		oProp.setValue(tKey, fValue);
		if(!approx_eq(oProp.getKeyValue(j), fValue)) return DTH_KEY_VALUE_LOST;
	}
	if(!bCanRead) return bValueMoved ? DTH_KEY_UNVERIFIED : DTH_KEY_IMMOVABLE;
	if(oProp.getKeyInterpolationType(j) == iInterp) return DTH_KEY_LINEAR;
	return bValueMoved ? DTH_KEY_FAILED : DTH_KEY_IMMOVABLE;
}

/**********************************************************************
 * The figure and EVERY node under it — the bones the ROM presets pose, the G9
 * mouth, the GP/DK geografts, conformed clothing. The complete set of nodes a
 * ROM carries keys on, which is what the final interpolation pass needs: a
 * root-and-mouth pass never saw a geograft's art-direction morphs, a frame-0
 * clothing fit, or a single bone rotation. */
function dthKeyedNodes(oNodeRoot){
	var aNodes = [oNodeRoot];
	if(!oNodeRoot || typeof oNodeRoot.getNodeChildren != "function") return aNodes;
	var aKids = oNodeRoot.getNodeChildren(true);
	for(var i = 0; aKids && i < aKids.length; i++){
		if(aKids[i]) aNodes.push(aKids[i]);
	}
	return aNodes;
}


/**********************************************************************
 * ONE SubD level across the figure tree - the VIEWPORT one and the RENDER one,
 * on every node that has them.
 *
 * Daz keeps the two subdivision levels as independent dials, and they are
 * routinely different. That difference makes the commonest question in this
 * pipeline unanswerable by looking: an artefact visible in the viewport need
 * not be in the rendered/exported mesh, and one that is invisible there may be
 * exactly what shipped. Stamping both to the same level before the ROM is built
 * removes the whole class of doubt - what you judge a pose by is what gets
 * captured.
 *
 * THE PROPERTY SPELLINGS BELOW ARE UNVERIFIED, and this pass is built so that
 * does not matter. The candidate names are tried first only because a lookup is
 * cheap; when none resolves, the owner's property list is searched by SHAPE
 * (a dial whose name or label carries "subd" and "level", split on whether it
 * also says "render") and whatever is found is NAMED in the Daz log - so the
 * first real run reports the true spellings and they can be pinned here.
 * Nothing trusts a setter that merely didn't throw: every level is read back.
 */
var DTH_SUBD_VIEW_NAMES = ["SubDIALevel", "SubDivisionLevel"];
var DTH_SUBD_RENDER_NAMES = ["SubDRenderLevel", "SubDivisionRenderLevel"];
/** How many unstampable nodes get named in the run log before the list is cut.
 *  Per KIND, never one shared pool - a flood of one kind must not erase the
 *  other, which is the rarer and more interesting one. */
var DTH_SUBD_REPORT_CAP = 8;

/** Every property of oOwner, or [] when it cannot be enumerated. Two shapes
 *  because DzElement subclasses do not agree on one: an indexed pair
 *  (getNumProperties/getProperty) and a list accessor. */
function dthPropertyList(oOwner){
	if(!oOwner) return [];
	if(typeof oOwner.getNumProperties == "function" && typeof oOwner.getProperty == "function"){
		var aOut = [];
		var iNum = oOwner.getNumProperties();
		for(var i = 0; i < iNum; i++){
			var oP = oOwner.getProperty(i);
			if(oP) aOut.push(oP);
		}
		return aOut;
	}
	if(typeof oOwner.getPropertyList == "function"){
		var aList = oOwner.getPropertyList();
		return aList ? aList : [];
	}
	return [];
}

/** The first property on oOwner answering to any of aNames - by name, then by
 *  label, the same two-step every other lookup in this runtime makes. */
function dthFindPropByNames(oOwner, aNames){
	if(!oOwner || typeof oOwner.findProperty != "function") return null;
	for(var i = 0; i < aNames.length; i++){
		var oProp = oOwner.findProperty(aNames[i]);
		if(oProp) return oProp;
		if(typeof oOwner.findPropertyByLabel == "function"){
			oProp = oOwner.findPropertyByLabel(aNames[i]);
			if(oProp) return oProp;
		}
	}
	return null;
}

/** A SubD LEVEL dial found by shape rather than by name. bRender picks the
 *  render one, else the viewport one - the two are told apart by the word
 *  "render" appearing in either the name or the label, which is the only thing
 *  they can be assumed to differ by. */
function dthDiscoverSubDProp(oOwner, bRender){
	var aProps = dthPropertyList(oOwner);
	for(var i = 0; i < aProps.length; i++){
		var oP = aProps[i];
		var sName = typeof oP.getName == "function" ? String(oP.getName()) : "";
		var sLabel = typeof oP.getLabel == "function" ? String(oP.getLabel()) : "";
		var sBoth = (sName + " " + sLabel).toLowerCase();
		// "subdivision" starts with "subd", so one test covers both spellings.
		if(sBoth.indexOf("subd") < 0 || sBoth.indexOf("level") < 0) continue;
		if((sBoth.indexOf("render") >= 0) == bRender) return oP;
	}
	return null;
}

/** Set one level and PROVE it: true only when the dial reads back as iLevel.
 *  A dial clamped to its own maximum reports the clamp honestly this way,
 *  instead of passing as set. */
function dthSetSubDProp(oProp, iLevel){
	if(!oProp || typeof oProp.setValue != "function" || typeof oProp.getValue != "function")
		return false;
	oProp.setValue(iLevel);
	return Math.round(Number(oProp.getValue())) == iLevel;
}

/** Switch a mesh to its High Resolution item, so a stamped level above 0 is not
 *  a silent no-op: a mesh sitting at Base subdivides to nothing whatever its
 *  SubD dials say. The item is found by its own string (anything carrying
 *  "high"), never by a guessed index - an enum's ordering is not a contract. */
function dthSetHighResolution(oOwner){
	var aProps = dthPropertyList(oOwner);
	for(var i = 0; i < aProps.length; i++){
		var oP = aProps[i];
		var sName = typeof oP.getName == "function" ? String(oP.getName()) : "";
		var sLabel = typeof oP.getLabel == "function" ? String(oP.getLabel()) : "";
		var sBoth = (sName + " " + sLabel).toLowerCase();
		if(sBoth.indexOf("resolution") < 0 || sBoth.indexOf("level") < 0) continue;
		if(typeof oP.getNumItems != "function" || typeof oP.getItem != "function") continue;
		var iNum = oP.getNumItems();
		for(var j = 0; j < iNum; j++){
			var sItem = String(oP.getItem(j)).toLowerCase();
			if(sItem.indexOf("high") < 0) continue;
			if(typeof oP.setValue == "function") oP.setValue(j);
			return true;
		}
	}
	return false;
}

/**
 * Stamp iLevel on every node under oNodeRoot that HAS a subdivision level.
 *
 * "Matching" is exactly that - a bone, a null or a light has no SubD dials and
 * is passed over in silence, while the figure, its geografts and every
 * conformed item get the same level on both dials. Scope is the FIGURE TREE,
 * not the scene: a prop or a backdrop is not exported and its subdivision is
 * the user's business.
 *
 * A level that will not take is a WARNING, never an error. The test is the one
 * the run log's two channels are for: are the exported artifacts still correct?
 * They are - the scene simply keeps its own subdivision, which is what every
 * ROM did before this pass existed. Aborting the export over it would trade a
 * cosmetic mismatch for no export at all.
 */
function dthApplySubDLevel(oNodeRoot, iLevel){
	// Absent / -1 is "leave the scene alone", which is also what a config from
	// an older studio says by carrying no key at all.
	if(iLevel === undefined || iLevel === null || iLevel < 0) return;
	var aNodes = dthKeyedNodes(oNodeRoot);
	var iStamped = 0, iPartial = 0;
	var aUnstamped = [];
	var sFoundView = "", sFoundRender = "";
	for(var i = 0; i < aNodes.length; i++){
		var oNode = aNodes[i];
		if(!oNode) continue;
		// The dials live on the node for some meshes and on its object for
		// others, so both are asked before a node is called SubD-less.
		var aOwners = [oNode];
		if(typeof oNode.getObject == "function"){
			var oObj = oNode.getObject();
			if(oObj) aOwners.push(oObj);
		}
		var oView = null, oRender = null;
		for(var k = 0; k < aOwners.length && !oView && !oRender; k++){
			oView = dthFindPropByNames(aOwners[k], DTH_SUBD_VIEW_NAMES) ||
				dthDiscoverSubDProp(aOwners[k], false);
			oRender = dthFindPropByNames(aOwners[k], DTH_SUBD_RENDER_NAMES) ||
				dthDiscoverSubDProp(aOwners[k], true);
			// Above 0 the level means nothing while the mesh sits at its base
			// resolution, so the same owner is switched to High first.
			if((oView || oRender) && iLevel > 0) dthSetHighResolution(aOwners[k]);
		}
		if(!oView && !oRender) continue;
		// Report the spellings ONCE (they are the same across a scene) - this
		// is the line that turns the guesswork above into a measured fact.
		if(oView && !sFoundView && typeof oView.getName == "function") sFoundView = String(oView.getName());
		if(oRender && !sFoundRender && typeof oRender.getName == "function") sFoundRender = String(oRender.getName());
		var bView = oView ? dthSetSubDProp(oView, iLevel) : false;
		var bRender = oRender ? dthSetSubDProp(oRender, iLevel) : false;
		if(bView && bRender){ iStamped++; continue; }
		// Half a stamp is the one outcome worth separating: it leaves the
		// viewport and the render DISAGREEING, which is the exact condition
		// this pass exists to remove.
		if(bView || bRender) iPartial++;
		if(aUnstamped.length < DTH_SUBD_REPORT_CAP){
			aUnstamped.push(oNode.getLabel() +
				" (viewport " + (oView ? (bView ? "ok" : "refused") : "absent") +
				", render " + (oRender ? (bRender ? "ok" : "refused") : "absent") + ")");
		}
	}
	print("SubD level " + iLevel + " stamped on " + iStamped + " node(s)" +
		(sFoundView ? "; viewport dial '" + sFoundView + "'" : "") +
		(sFoundRender ? ", render dial '" + sFoundRender + "'" : ""));
	if(aUnstamped.length > 0){
		logRunWarning("SubD level " + iLevel + " could not be set on " +
			(iPartial > 0 ? iPartial + " node(s) fully and " : "") +
			aUnstamped.length + " node(s) at all - they keep the scene's own subdivision: " +
			aUnstamped.join(", "));
	}
}

function setLinearInterp(oNodes){

	var iInterp = dthLinearInterp();
	// No constant to stamp WITH: dthLinearInterp has already logged that, and
	// there is nothing this pass can do about it. Return before touching the
	// scene rather than nudging thousands of values for no possible gain.
	if(iInterp === undefined) return;
	// Set the session default to match, so keys created later start out right.
	// It takes the RESOLVED constant: `DzProperty.Linear` — what this line
	// passed until v78 — is undefined on DS 4.24 (measured), so the call has
	// been handing Daz an undefined enum for as long as it has existed. Now
	// that it lands, it OUTLIVES the run: the user's Daz keeps creating Linear
	// keys until they change it back or restart (documented in the gotchas).
	Scene.setDefaultKeyInterpolationType(iInterp);

	var aChannels = collectInterpChannels(oNodes);
	print("Animated channels to set LINEAR interp:", aChannels.length)

	var iKeys = 0, iLinear = 0, iUnverified = 0, iSpansNothing = 0, iStuck = 0;
	var iFailedKeys = 0, iValueLost = 0, iZeroAdded = 0, iZeroFailed = 0;
	// Per-kind naming budget (see logRunKeyProblem) and the entries that made it
	// in, kept per kind so each message can quote its OWN keys.
	var oNamed = {};
	var aFailed = [], aStuck = [], aValueLost = [], aZeroFailed = [];
	for(var i = 0; i < aChannels.length; i++){
		var oChan = aChannels[i];
		var oProp = oChan.prop;
		var sZero = dthEnsureFrameZeroKey(oProp, iInterp);
		if(sZero == DTH_ZERO_ADDED) iZeroAdded++;
		else if(sZero == DTH_ZERO_DRIVEN || sZero == DTH_ZERO_REFUSED){
			iZeroFailed++;
			var oZeroEntry = logRunKeyProblem(oNamed, dthKeyProblemEntry("frame-zero", oChan, -1, 0, undefined,
				(sZero == DTH_ZERO_DRIVEN)
					? "driven by a controller - keying frame 0 from getValue would double-apply the controller's contribution"
					: "no key could be made at frame 0"));
			if(oZeroEntry) aZeroFailed.push(oZeroEntry);
		}
		// DTH_ZERO_ROLLED_BACK is deliberately absent: it already logged a run
		// ERROR naming the channel, and counting it here too would report one
		// problem twice, once as fatal and once as a warning.
		var iNumKeys = oProp.getNumKeys();
		// A key that cannot be re-keyed is only harmless when it is the
		// channel's ONE key and it sits at frame 0, where interpolation spans
		// nothing. Every immovable channel measured was exactly that — but ASK
		// this scene rather than repeat that measurement as if it were a law.
		var bBenignIfStuck = (iNumKeys == 1 && oProp.getKeyTime(0) == 0);
		var bCanRead = (typeof oProp.getKeyInterpolationType == "function");
		// One channel contributes ONE name per kind, not one per key: a channel
		// with 200 bad keys must not spend the whole budget the four keys on
		// four other channels needed.
		var oChanNamed = {};
		for(var j = 0; j < iNumKeys; j++){
			iKeys++;
			var sResult = dthStampKeyLinear(oProp, j, iInterp);
			if(sResult == DTH_KEY_LINEAR){ iLinear++; continue; }
			if(sResult == DTH_KEY_UNVERIFIED){ iUnverified++; continue; }
			// A key that is its channel's ONLY key, at frame 0, interpolates
			// across nothing — there is no second key to travel to. So its
			// interpolation type cannot change any value anywhere, and whether
			// the stamp took is not a fact worth reporting.
			//
			// This used to apply to IMMOVABLE only, and that was an accident of
			// how the measurement was made rather than a rule: the sample that
			// taught us about spans-nothing channels was locked/driven, so they
			// all refused the nudge. A channel whose value DOES move and still
			// won't read back LINEAR is the same nothing when it holds one key at
			// frame 0 — and that is precisely what the first real report found
			// (2026-08-17): 4 of 7968 keys, all frame 0, all Bone Fill/Edge
			// Opacity — VIEWPORT DRAWING dials under /Display/Scene View/Bones,
			// which nobody animated at all. They only reached the walk because
			// Daz reports an implicit frame-0 key for never-keyed channels. The
			// old classification turned that into a warning on a real character's
			// run report, and before v79 into a blocked export.
			if(bBenignIfStuck && (sResult == DTH_KEY_IMMOVABLE || sResult == DTH_KEY_FAILED)){
				iSpansNothing++; continue;
			}
			var sKind, sReason;
			if(sResult == DTH_KEY_VALUE_LOST){
				iValueLost++; sKind = "value-lost";
				sReason = "the nudge could not be put back - this key's VALUE is wrong";
			} else if(sResult == DTH_KEY_FAILED){
				iFailedKeys++; sKind = "failed";
				sReason = "the value moved (so Daz rewrote the key) and it still does not read back LINEAR";
			} else {
				iStuck++; sKind = "stuck";
				sReason = "the value would not move in either direction, so Daz never rewrote the key";
			}
			if(oChanNamed[sKind]) continue;
			oChanNamed[sKind] = true;
			// Read the interpolation back ONCE, here: the report should say what
			// Daz actually holds, not merely that it isn't LINEAR. Affordable
			// because this is the rare path — the fast one `continue`d above.
			var iRead = bCanRead ? oProp.getKeyInterpolationType(j) : undefined;
			var oEntry = logRunKeyProblem(oNamed,
				dthKeyProblemEntry(sKind, oChan, j, oProp.getKeyTime(j), iRead, sReason));
			if(!oEntry) continue;
			if(sKind == "value-lost") aValueLost.push(oEntry);
			else if(sKind == "failed") aFailed.push(oEntry);
			else aStuck.push(oEntry);
		}
	}
	print("LINEAR on", iLinear, "of", iKeys, "key(s);", iSpansNothing,
		"span nothing;", iZeroAdded, "frame-0 key(s) made real");
	// The list that was missing. A run reporting "4 of 7968 key(s) would not read
	// back LINEAR" named nothing at all, so there was nothing to chase — not the
	// node, not the dial, not the frame. Every named key goes to the Daz log AND
	// into the run log's keyProblems, which is what the studio shows.
	if(DTH_RUN_LOG.keyProblems.length > 0){
		print("Key interpolation - the keys that could not be stamped (up to",
			DTH_KEY_PROBLEM_CAP, "channels per kind; the counts below are exact):");
		for(var q = 0; q < DTH_RUN_LOG.keyProblems.length; q++){
			var oQ = DTH_RUN_LOG.keyProblems[q];
			print("   ", oQ.kind + ":", dthKeyProblemLine(oQ), "-", oQ.reason);
		}
	}
	// A single key at frame 0 on a locked transform or a hidden ERC controller
	// cannot be re-keyed and does not need to be. Worth saying; not worth
	// failing a run over. Everything below it IS.
	if(iSpansNothing > 0){
		print("NOTE:", iSpansNothing, "key(s) would not take a new value - each is its channel's only key, at frame 0, where interpolation spans nothing.");
	}
	// A wrong VALUE is the worst thing this pass can leave behind - and the only
	// one that still blocks the export, because it is the only one that makes a
	// POSE FRAME wrong. Louder than any interpolation problem, and named first.
	if(iValueLost > 0){
		logRunError("Key interpolation: " + iValueLost + " key(s) could not be restored to their original value after the interpolation rewrite. Those keys are off by up to " +
			DTH_INTERP_NUDGE + " - re-run the ROM and check them before exporting." +
			dthKeyProblemSample(aValueLost, iValueLost));
	}
	/* Everything below is a WARNING, and that is a deliberate change (runtime
	 * v79). It used to be logRunError, which counts as a run problem, which makes
	 * ApplyDTHCharacter return false, which makes the generated script skip the
	 * export entirely — so a run where 4 keys of 7968 kept the wrong
	 * interpolation built the ROM and exported NOTHING, and the studio showed a
	 * row marked "done" with no reason on it. Measured, on LaraCroft_G81.
	 *
	 * What a non-LINEAR key actually costs: the key's own VALUE is untouched (the
	 * pass restores it and re-reads it, and a value it cannot restore is the
	 * error above). Interpolation decides the curve BETWEEN keys, so every keyed
	 * pose frame is identical either way — the measured basis for that is in
	 * .ai/gotchas-daz.md, from reading a shipped ROM .duf. A PoseAsset export
	 * samples whole pose frames, so these keys do not change what ships.
	 *
	 * That is why they are reported rather than fatal. It is NOT a claim that
	 * they are fine: they are named now, individually, in the Daz log and in the
	 * studio, so the next person can decide with the channel in front of them
	 * instead of a count. */
	if(iZeroFailed > 0){
		logRunWarning("Key interpolation: " + iZeroFailed + " channel(s) kept an implicit frame-0 key (driven value, or no key could be made there) - frame 0 falls back to Daz's default interpolation on those." +
			dthKeyProblemSample(aZeroFailed, iZeroFailed));
	}
	if(iStuck > 0){
		logRunWarning("Key interpolation: " + iStuck + " key(s) on multi-key or non-zero-frame channels would not take a new value, so they keep their old interpolation. The keys' values are unchanged, so the exported pose frames are unaffected." +
			dthKeyProblemSample(aStuck, iStuck));
	}
	if(iFailedKeys > 0){
		logRunWarning("Key interpolation: " + iFailedKeys + " of " + iKeys +
			" key(s) would not read back LINEAR, so they keep Daz's default interpolation. Their values are unchanged and every pose frame is exact - only the motion BETWEEN pose frames on those channels differs, which a PoseAsset export does not sample. The export was NOT blocked." +
			dthKeyProblemSample(aFailed, iFailedKeys));
	}
	// Stamped, but this build cannot report interpolation back, so the pass has
	// NOT been confirmed. Say that instead of counting them as wins — and do not
	// block on it either: "this Daz cannot answer the question" is not evidence
	// that the answer is bad, and blocking would make such a build unusable.
	if(iUnverified > 0){
		logRunWarning("Key interpolation: " + iUnverified + " key(s) were rewritten LINEAR but this Daz build has no getKeyInterpolationType, so none of it could be verified.");
	}
}

/**********************************************************************
 * Loads preset `sFilename` with `oTarget` node selected, at frame `startframe` 
 * startFrame = 0 		*/
function loadPreset(sFilename, oTarget, startFrame)
{
 	startFrame = typeof startFrame !== 'undefined' ? startFrame : 0;
 	var oContentMgr = App.getContentMgr();
	print("Loading", sFilename, "to", oTarget.getLabel(), "at frame", startFrame);
	var newTime = Scene.getTimeStep() * startFrame;
	Scene.selectAllNodes(false);
	oTarget.select(true);
	Scene.setPrimarySelection(oTarget);
	Scene.setTime(newTime);
	return oContentMgr.openFile(sFilename);
}

/**********************************************************************
 *Sets total frames */
function setTotalFrames(iTotalFrames){
	var oTimeRange = new DzTimeRange(0, iTotalFrames * Scene.getTimeStep());
	print("Setting new time range:", oTimeRange.start, "to", oTimeRange.end);
	Scene.setAnimRange(oTimeRange);
	// Also extend the play range — otherwise the timeline scrubber stays bounded
	// to the previous (shorter) play range and you can't reach the later frames
	// (e.g. the FBM section after the GP block).
	Scene.setPlayRange(oTimeRange);
}

/**********************************************************************
 *Adds new frames to end of the anim play range. No arguments adds 1 frame.*/
function addFramesToAnim(iNewFrames){
 iNewFrames = typeof iNewFrames !== 'undefined' ? iNewFrames : 1;
	var oTimeRange = new DzTimeRange(0, Scene.getAnimRange().end + Scene.getTimeStep(0) * iNewFrames);
	Scene.setAnimRange(oTimeRange);
}

/**********************************************************************
 *Memorizes figure for `oNode` at `iSourceFrame`, Restores Figure for each frame in `aTargetFrames`.*/
function setFencePoses(oNode, iSourceFrame, aTargetFrames){
	var timeStep = Scene.getTimeStep();
	Scene.selectAllNodes(false);
	oNode.select();
	Scene.setPrimarySelection(oNode);
	Scene.setTime(iSourceFrame * timeStep);
	print("Memorizing figure for:", oNode.getLabel(), "at frame", iSourceFrame);
	triggerAction("DzMemorizeFigureAction");
	// Indexed loop, NOT for-in: DAZ's engine exposes enumerable Array.prototype
	// extensions (map/forEach/…), so for-in over an array also yields those —
	// restoring the figure at frame `function f(){…}` (NaN time) and "".
	for( var i = 0; i < aTargetFrames.length; i++){
		var frame = aTargetFrames[i];
		Scene.setTime(frame * timeStep);
		print("Restoring figure for:", oNode.getLabel(), "at frame", frame);
		triggerAction("DzRestoreFigureAction");	
	}
}

// function getKeysAtFrame(oNode, )

/**********************************************************************
 *Sets property `sPropName` on `oNode` to `fValue` at time `iFrame`.
 * iFrame = 0  		*/
function setPropertyByName(oNode, sPropName, fValue, iFrame){
 	iFrame = typeof iFrame !== 'undefined' ? iFrame : 0;
 	print("Setting property", sPropName, "to", fValue, "at frame", iFrame, "...");
	var oProp = oNode.findProperty(sPropName);
	if (!oProp){
		logRunFailedMorph(iFrame, oNode.getLabel(), sPropName, "property not found");
		return false;
	}
	var tFrame = iFrame * Scene.getTimeStep();
	// setValue returns false when the value is ALREADY fValue (nothing to change),
	// so don't gate success on its return — verify by reading the value back. This
	// stops a no-op (e.g. FACS Detail Strength already at 1) logging a false "Failed".
	//
	// The interpolation goes through the RESOLVED constant (v78): this line used to
	// pass `DzProperty.Linear`, which is undefined on DS 4.24 — and unlike the
	// session default, an interpolation ARGUMENT is the thing that lands on the key
	// (measured; see dthStampKeyLinear). So this call has been handing Daz an
	// undefined enum on the one call form where the argument decides.
	dthSetValueInterp(oProp, tFrame, fValue, dthLinearInterp());
	if (approx_eq(oProp.getValue(tFrame), fValue)){
		print("Set property", oProp.getLabel(), "to", fValue, "at frame", iFrame);
		return true;
	}
	logRunFailedMorph(iFrame, oNode.getLabel(), sPropName, "value did not apply (limits?)");
	return false;
}


/** deprecated - use loadPreset ***********************/
function loadDufToNode(oNodeRoot, sDufPath, sChildLabel){
	var oChildNode;
	if(sChildLabel) 
		oChildNode = oNodeRoot.findNodeChildByLabel(sChildLabel);
	if(!oChildNode){
		Scene.setPrimarySelection(oNodeRoot);
		print("Loading DUF: ", sDufPath, "to add", sChildLabel, "to node", oNodeRoot.getLabel(), "...");
		if( oContentMgr.openFile(sDufPath) ) {
			print("Successfully loaded");
			return true;
		} else {
			print("Failed to load DUF: ", sDufPath, "to add", sChildLabel, "to node", oNodeRoot.getLabel(), "...");
			return false;
		}
	} else {
		print(sChildLabel, "already exists on node:", oNodeRoot.getLabel());
		return true;
	}
}

function getMorphPropFromNode(oNode, sMorphName){
	var oObj = oNode.getObject();
	if(oObj)
	{
		var oMorph = oObj.findModifier(sMorphName);
		if(oMorph){
			// getValueChannel() takes no args — passing 0 logs "Too many
			// arguments, ignoring 1" on every morph (this is the hot path).
			var oProp = oMorph.getValueChannel();
			return oProp;
		}
	}
}

function addFrameData(frameDatas, keyData){
	var idx = keyData.frameIdx;
	if(idx == undefined || idx == null)
		return false;
	if (frameDatas[idx] !== undefined)
		frameDatas[idx].keyDatas.push(keyData);
	else
		frameDatas[idx] = {frameName: "", sectionName: "", keyDatas: [keyData]};
	return true;
}

// Frame data JSON format (inline `config.extraFrames` of the character script):
// {
//   "meta": { "version": "1.0", "description": "..." },
//   "frames": [
//     {
//       "frame": 100,  // Relative frame offset (added to iOffset)
//       "section": "GP9",
//       "name": "Anus_Open",
//       "morphs": [
//         { "node": "GoldenPalace_G9", "prop": "GP9_Anus_Open", "value": 1.0 },
//         { "node": "GoldenPalace_G9", "prop": "GP9_Anus_Depth", "value": 0.5, "base": 0.2 }
//       ]
//     }
//   ]
// }
/**
 * Process an already-parsed frame-data object (the inline `config.extraFrames`
 * of the character script — same shape as the historical *_FBMs.json files)
 * into `frameDatas`. Gen-block leakage needs no handling here: runtime v27
 * closes every block's dangling keys at its boundary (closeDanglingMorphKeys).
 */
function processFrameDataJSON(jsonData, frameDatas, iOffset){
	frameDatas = frameDatas || [];
	iOffset = iOffset || 0;

	if (!jsonData || !jsonData.frames || !Array.isArray(jsonData.frames)) {
		print("ERROR: frame data missing 'frames' array");
		return frameDatas;
	}

	var frameCount = 0;
	for (var i = 0; i < jsonData.frames.length; i++) {
		var frameEntry = jsonData.frames[i];
		var frameNum = parseInt(frameEntry.frame) + iOffset;
		// A bad frame number must not silently shorten the timeline (drift!) —
		// log it and skip just this entry; every valid frame keeps its slot.
		if (isNaN(frameNum) || frameNum < 0) {
			logRunError("Frame entry " + i + " ('" + (frameEntry.name || "") +
				"') has an invalid frame number: " + frameEntry.frame);
			continue;
		}

		if (!frameDatas[frameNum]) {
			frameDatas[frameNum] = {
				keyDatas: [],
				sectionName: frameEntry.section || "",
				frameName: frameEntry.name || ""
			};
		}

		if (frameEntry.morphs && Array.isArray(frameEntry.morphs)) {
			for (var j = 0; j < frameEntry.morphs.length; j++) {
				var morph = frameEntry.morphs[j];
				var keyData = {
					frameIdx: frameNum,
					nodeName: morph.node,
					propName: morph.prop,
					propValue: parseFloat(morph.value),
					baseValue: (morph.base !== undefined) ? parseFloat(morph.base) : 0,
					autoBase: (morph.autoBase === true)
				};
				addFrameData(frameDatas, keyData);
				verbose("add JSON frame data. frame:", frameNum, "prop:", morph.prop, "base:", keyData.baseValue, "autoBase:", keyData.autoBase);
			}
		}
		frameCount++;
	}

	// Optional `groups` array: frame ranges whose generation method needs a
	// differently shaped timeline (additive: the first pose sustains across
	// the group; cumulative: every pose sustains until the group end).
	if (jsonData.groups && Array.isArray(jsonData.groups)) {
		annotateGroupMethods(frameDatas, jsonData.groups, iOffset);
	}

	print("added", frameCount, "frames from frame data");
	return frameDatas;
}


/** Marks the keyDatas of additive/cumulative group ranges so applyKeyData
 *  can create sustained keys instead of the per-frame sawtooth.
 *  advancedAdditive shapes the timeline like additive (the distinction is
 *  Houdini-side). Props repeating within a cumulative group are ramps
 *  (e.g. AnusOpen 22/35/80) — they skip the base re-anchor before their frame. */
function annotateGroupMethods(frameDatas, groups, iOffset){
	for (var g = 0; g < groups.length; g++) {
		var group = groups[g];
		var method = group.method === "advancedAdditive" ? "additive" : group.method;
		if (method !== "additive" && method !== "cumulative") continue;
		var startFrame = parseInt(group.startFrame) + iOffset;
		var endFrame = parseInt(group.endFrame) + iOffset;
		var seenProps = {};
		for (var f = startFrame; f <= endFrame; f++) {
			var frameData = frameDatas[f];
			if (!frameData || !frameData.keyDatas) continue;
			for (var k = 0; k < frameData.keyDatas.length; k++) {
				var keyData = frameData.keyDatas[k];
				var propKey = keyData.nodeName + "|" + keyData.propName;
				keyData.groupMethod = method;
				keyData.groupStart = startFrame;
				keyData.groupEnd = endFrame;
				keyData.isGroupBase = (f === startFrame);
				keyData.rampContinuation = (seenProps[propKey] === true);
				seenProps[propKey] = true;
			}
		}
		print("annotated", method, "group", (group.name || ""), "frames", startFrame, "-", endFrame);
	}
}

function printCSV(frameDatas, sOutFilename){
	lines = [];
	if(!frameDatas){
		print("ERROR: printCSV received null `frameDatas`");
		return false;
	}
	for (i = 0; i < frameDatas.length; i++){
		var line;
		var frameData = frameDatas[i];
		if(frameData && frameData.keyDatas !== undefined)
		{ 
			var keyDatas = frameData.keyDatas;
			line = [i.toString(), frameData.sectionName || "", frameData.frameName || ""];
			verbose("Frame", i, "length:", keyDatas.length);	
			for (j = 0; j < keyDatas.length; j++)
			{
				var keyData = keyDatas[j];
				line.push(keyData.nodeName, keyData.propName, keyData.propValue);
			}
			verbose("line length:", line.length);
		}
		else{
			line = [i.toString(), "", ""];
		}
		lines.push(line.join(","));
	}

	if(sOutFilename){
		oFile = new DzFile( sOutFilename );
		if ( oFile.open( oFile.WriteOnly, oFile.Truncate ) ) {

			print("Writing to", sOutFilename);
			for (var n = 0; n < lines.length; n++){
				print(lines[n]);
				oFile.write(lines[n] + "\n");
		    }
		    oFile.close();
		}	
	}
	else
	{
		for (var n = 0; n<lines.length;n++){
			print(lines[n]);
		}
	}
	
}

/** **************************************************************************/
function createMorphFrames( oNode, morphConfigs, iStartFrame){
	print("Entering createMorphFrames at frame ", iStartFrame, ", creating ", morphConfigs.length, "frames");
	if(!oNode){
		print("oNode null, returning");
		return false;
	}
	var timeStep = Scene.getTimeStep();
	var iNewFrames = (iStartFrame + morphConfigs.length) - (Scene.getAnimRange().end/timeStep);
	if(iNewFrames > 0)
		addFramesToAnim(iNewFrames);

	for(var i=1; i<morphConfigs.length; i++){
		print("executing morph", i, " in configs");
		var frameConfig = morphConfigs[i];
		// print("   " + frameConfig);
		for ( var j=0; j<frameConfig.length; j++){
			var config = frameConfig[j];
			var oProp = oNode.findProperty(config.name);
			if (!oProp)
				oProp = oNode.findPropertyByLabel(config.name);
			if(!oProp){
				oProp = getMorphPropFromNode(oNode, config.name)
			}
			if(!oProp){
				// continue (NOT break): one missing morph must not drop the rest
				// of this frame's morphs — the frame slot and count stay intact.
				logRunFailedMorph(iStartFrame + i, oNode.getLabel(), config.name, "morph/property not found");
				continue;
			}
			fValue = config.value || 1;
			var success = createMorphFrame(oProp, iStartFrame + i, fValue);

		}
	}
}


// Reset all morphs in frameDatas to 0 at a specific frame (typically frame 0)
// This preserves the base state and prevents interpolation issues
function resetFrameDatasAtFrame(oNodeRoot, frameDatas, resetFrame){
	resetFrame = resetFrame || 0;
	var timeStep = Scene.getTimeStep();
	var processedProps = {}; // Track which props we've already reset

	for(var i = 0; i < frameDatas.length; i++){
		var frameData = frameDatas[i];
		if(frameData && frameData.keyDatas){
			for(var j = 0; j < frameData.keyDatas.length; j++){
				var keyData = frameData.keyDatas[j];
				if(!keyData.propName || processedProps[keyData.propName]) continue;

				// Find the node
				var oNode;
				if(oNodeRoot.getName() == keyData.nodeName || oNodeRoot.getLabel() == keyData.nodeName)
					oNode = oNodeRoot;
				else
					oNode = oNodeRoot.findNodeChild(keyData.nodeName, true);
				if(!oNode)
					oNode = oNodeRoot.findNodeChildByLabel(keyData.nodeName, true);

				if(oNode){
					// Find the property (same logic as applyKeyData)
					var oProp = getMorphPropFromNode(oNode, keyData.propName);
					if(!oProp){
						var oObj = oNode.getObject();
						if(oObj){
							for(var m = 0; m < oObj.getNumModifiers(); m++){
								var mod = oObj.getModifier(m);
								if(mod.getLabel() === keyData.propName || mod.getName() === keyData.propName){
									if(mod.getValueChannel) oProp = mod.getValueChannel();
									if(!oProp && mod.getValueControl) oProp = mod.getValueControl();
									if(oProp) break;
								}
							}
						}
					}

					if(oProp){
						// Use baseValue for reset (respects pre-existing morph values)
						var resetValue = (keyData.baseValue !== undefined) ? keyData.baseValue : 0;
						oProp.setValue(resetFrame * timeStep, resetValue);
						processedProps[keyData.propName] = true;
						verbose("Reset", keyData.propName, "to", resetValue, "at frame", resetFrame);
					}
				}
			}
		}
	}
	print("Reset", Object.keys(processedProps).length, "morphs at frame", resetFrame);
}


/** Resolves autoBase flags in frameDatas by reading current property values from the scene.
 *  Must be called before applyFrameDatas so that baseValue reflects the scene state. */
function resolveAutoBaseValues(oNodeRoot, frameDatas){
	var resolved = 0;
	for(var i = 0; i < frameDatas.length; i++){
		var frameData = frameDatas[i];
		if(frameData && frameData.keyDatas){
			for(var j = 0; j < frameData.keyDatas.length; j++){
				var keyData = frameData.keyDatas[j];
				if(!keyData.autoBase) continue;

				// Find the node
				var oNode;
				if(oNodeRoot.getName() == keyData.nodeName || oNodeRoot.getLabel() == keyData.nodeName)
					oNode = oNodeRoot;
				else
					oNode = oNodeRoot.findNodeChild(keyData.nodeName, true);
				if(!oNode)
					oNode = oNodeRoot.findNodeChildByLabel(keyData.nodeName, true);

				if(oNode){
					var oProp = getMorphPropFromNode(oNode, keyData.propName);
					if(!oProp){
						var oObj = oNode.getObject();
						if(oObj){
							for(var m = 0; m < oObj.getNumModifiers(); m++){
								var mod = oObj.getModifier(m);
								if(mod.getLabel() === keyData.propName || mod.getName() === keyData.propName){
									if(mod.getValueChannel) oProp = mod.getValueChannel();
									if(!oProp && mod.getValueControl) oProp = mod.getValueControl();
									if(oProp) break;
								}
							}
						}
					}

					if(oProp){
						// Read the current value at time 0 (base state)
						var currentValue = oProp.getValue(0);
						keyData.baseValue = currentValue;
						print("autoBase resolved:", keyData.propName, "current value:", currentValue);
						resolved++;
					}
				}
				// Clear the flag so it's not re-processed
				keyData.autoBase = false;
			}
		}
	}
	if(resolved > 0) print("Resolved", resolved, "autoBase morph values from scene");
}


function applyFrameDatas(oNodeRoot, frameDatas, successFrameDatas, failedFrameDatas, startFrame)
{

	verbose("! Applying frameDatas");
	startFrame = startFrame || 0;

	var successFrameDatas = successFrameDatas || [];
	var failedFrameDatas = failedFrameDatas || [];
	if(Scene.getAnimRange().end / Scene.getTimeStep() < frameDatas.length)
		setTotalFrames(frameDatas.length);
	for(var i = startFrame; i < frameDatas.length; i++){
		// The finest interrupt point the ROM has: one frame's keys are applied
		// or they are not, and stopping between two frames leaves the timeline
		// exactly as coherent as stopping after the last one. The caller
		// (ApplyDTHWorkflow) checks again right after and ends the run — this
		// loop only has to stop growing the ROM.
		if(dthStopRequested()){
			print("ROM frame loop interrupted at frame", i, "of", frameDatas.length);
			return;
		}
		verbose("  applying frame:", i);
		var frameData = frameDatas[i];
		if(frameData){
			var keyDatas = frameData.keyDatas;
			if(keyDatas){
				for (var j = 0; j < keyDatas.length; j++)
				{
					var keyData = keyDatas[j];
					if(applyKeyData(oNodeRoot, keyData))
						addFrameData(successFrameDatas, keyData);
					else
						addFrameData(failedFrameDatas, keyData);
				}
			}
		}
	}
}

function applyKeyData(oNodeRoot, keyData, overrideFrameIdx){
	if(!oNodeRoot || !keyData.nodeName || !keyData.propName){
		print("ERROR: cannot call applyKeyData; missing paramters. ");
		return false;
	}
	print("Creating morph frame on", keyData.nodeName, "prop:", keyData.propName, "value:", keyData.propValue);
	var oNode;
	// Try matching by name or label
	if(oNodeRoot.getName() == keyData.nodeName || oNodeRoot.getLabel() == keyData.nodeName)
		oNode = oNodeRoot;
	else
		oNode = oNodeRoot.findNodeChild(keyData.nodeName, true);
	if(!oNode)
		oNode = oNodeRoot.findNodeChildByLabel(keyData.nodeName, true);
	if(oNode){
		print("  Node found:", oNode.getName(), "/ Label:", oNode.getLabel());
		var oProp = null;

		// FIRST: Try modifier lookup (most reliable for morphs)
		oProp = getMorphPropFromNode(oNode, keyData.propName);
		if(oProp){
			print("  Found via getMorphPropFromNode");
		}

		// SECOND: Loop through all modifiers and check by label/name
		if(!oProp){
			var oObj = oNode.getObject();
			if(oObj){
				for(var m = 0; m < oObj.getNumModifiers(); m++){
					var mod = oObj.getModifier(m);
					if(mod.getLabel() === keyData.propName || mod.getName() === keyData.propName){
						// Try different methods to get the value property
						if(mod.getValueChannel){
							oProp = mod.getValueChannel();
						}
						if(!oProp && mod.getValueControl){
							oProp = mod.getValueControl();
						}
						if(!oProp && mod.getChannel){
							oProp = mod.getChannel(0);
						}
						if(oProp){
							print("  Found via modifier loop by label/name:", keyData.propName);
							break;
						}
					}
				}
			}
		}

		// LAST RESORT: Try node property lookup (for non-morph properties like poses)
		if(!oProp){
			oProp = oNode.findProperty(keyData.propName);
			if(oProp) print("  Found via findProperty (fallback)");
		}
		if(!oProp){
			oProp = oNode.findPropertyByLabel(keyData.propName);
			if(oProp) print("  Found via findPropertyByLabel (fallback)");
		}

		if(oProp){
			// DAZ Studio 6 pops a "keep limits?" dialog when a value exceeds the
			// property's min/max. Disable clamping on this property so the morph
			// applies without any prompt (guarded — the method name may differ).
			if(typeof oProp.setIsClamped === "function") oProp.setIsClamped(false);
			//var iKey = oProp.getNumKeys();
			//*********** Main action - create the morph frame;
			// if(createMorphFrameByKey(oProp, keyData.frameIdx, keyData.propValue, iKey)){
			var frameIdx = overrideFrameIdx == undefined ? keyData.frameIdx : overrideFrameIdx;
			var baseValue = (keyData.baseValue !== undefined) ? keyData.baseValue : 0;

			// Check for noSawtooth flag - just set value at this frame without affecting adjacent frames
			if (keyData.noSawtooth) {
				var timeStep = Scene.getTimeStep();
				oProp.setValue(frameIdx * timeStep, keyData.propValue);
				verbose("Set value (no sawtooth) on", keyData.nodeName, "prop:", keyData.propName, "=", keyData.propValue, "at frame", frameIdx);
				return true;
			}

			// Additive/cumulative groups: the value sustains until the group
			// end instead of sawtoothing back on the next frame. For additive
			// only the base (first) pose sustains; the rest sawtooth normally.
			if (keyData.groupMethod === "cumulative" ||
				(keyData.groupMethod === "additive" && keyData.isGroupBase)) {
				if (createSustainedMorphFrame(oProp, frameIdx, keyData.propValue, baseValue,
						keyData.groupEnd, keyData.rampContinuation === true)) {
					verbose("Successfully created sustained morph frame on", keyData.nodeName, "prop:", keyData.propName, keyData.propValue);
					return true;
				}
				logRunFailedMorph(frameIdx, keyData.nodeName, keyData.propName, "could not create sustained keyframe");
				return false;
			}

			if(createMorphFrame(oProp, frameIdx, keyData.propValue, baseValue)){
				verbose("Successfully created morph frame on", keyData.nodeName, "prop:", keyData.propName, keyData.propValue);
				return true;
			}
			else{
				logRunFailedMorph(frameIdx, keyData.nodeName, keyData.propName, "could not create keyframe");
				return false;
			}
		}
		else{
			// The frame slot itself stays (frame counts come from the declaration),
			// so ONLY this morph is missing — the rest of the ROM stays aligned.
			logRunFailedMorph(keyData.frameIdx, keyData.nodeName, keyData.propName,
				"morph/property not found on node " + oNode.getLabel());
			return false;
		}
	}
	else {
		logRunFailedMorph(keyData.frameIdx, keyData.nodeName, keyData.propName,
			"node not found under " + oNodeRoot.getLabel());
		return false
	}
}

/**********************************************************************
 * Closes the dangling sawtooth a ROM block leaves at its end: a pose preset
 * can only key frames inside its own range, so a pose on the block's LAST
 * frame has no ramp-down key after it — that morph would hold its value
 * through every block that follows (e.g. the base ROM's final FAC neck pose
 * staying on across the whole GEN range). For every keyed morph modifier on
 * `oNodes` whose last key ends before `iBoundaryFrame` at a value different
 * from its frame-0 value, key that frame-0 value at `iBoundaryFrame` — the
 * same "next frame back to base" every non-final pose gets from the sawtooth.
 * Morphs already back at their frame-0 value are untouched, so flattened
 * preserved morphs and dials set once at frame 0 stay as they are. */
/**
 * Snapshot every morph's value on the given nodes into a name→value map, taken
 * BEFORE any ROM preset is loaded (right after ApplyInitialValues). The base-ROM
 * tail close-out (closeDanglingMorphKeys) uses this to tell a CHARACTER-owned
 * shape/controller morph — one the character/GP/preset dials to a non-zero base
 * (e.g. ProportionHeight) — apart from a pure ROM pose (base ~0, e.g. the final
 * FAC "neck under chin" pose). The former must never be re-keyed at the block
 * boundary: doing so re-applied its value on top of the ERC-driven contribution,
 * so a -10% character height read as -20% by frame 327. The latter still gets
 * its dangling tail closed.
 */
function memorizeBaseMorphs(oNodes){
	var map = {};
	for(var x = 0; x < oNodes.length; x++){
		var oNode = oNodes[x];
		if(!oNode) continue;
		var oObj = oNode.getObject();
		if(!oObj) continue;
		for(var i = 0; i < oObj.getNumModifiers(); i++){
			var oMod = oObj.getModifier(i);
			if(!oMod || !oMod.inherits("DzMorph")) continue;
			var oProp = oMod.getValueControl();
			if(!oProp) continue;
			map[oMod.getName()] = oProp.getValue(0);
		}
	}
	return map;
}

// `baselineValues` (optional): the pre-ROM morph snapshot from memorizeBaseMorphs.
// When passed (the base-ROM root close-out), a morph the character dialed to a
// non-zero base is left untouched — only ROM poses (base ~0) get their tail
// closed. Without it (the DK/GP geograft + mouth close-outs, whose morphs are
// self-contained ROM assets with no character-driven base) the old getValue(0)
// behaviour is unchanged.
function closeDanglingMorphKeys(oNodes, iBoundaryFrame, baselineValues){
	var timeStep = Scene.getTimeStep();
	var tBoundary = iBoundaryFrame * timeStep;
	var iClosed = 0;
	for(var x = 0; x < oNodes.length; x++){
		var oNode = oNodes[x];
		if(!oNode) continue;
		var oObj = oNode.getObject();
		if(!oObj) continue;
		for(var i = 0; i < oObj.getNumModifiers(); i++){
			var oMod = oObj.getModifier(i);
			if(!oMod || !oMod.inherits("DzMorph")) continue;
			var oProp = oMod.getValueControl();
			if(!oProp || oProp.getNumKeys() < 1) continue;
			var iLastKey = oProp.getNumKeys() - 1;
			// A key at/past the boundary means the block manages its own tail.
			if(oProp.getKeyTime(iLastKey) >= tBoundary) continue;
			// Close BACK to the pre-ROM baseline when we have one — never to a
			// post-ROM getValue(0), which for a preset-driven controller already
			// carries the ROM's contribution and so double-applies it.
			var sKey = oMod.getName();
			var bHasBaseline = baselineValues && (baselineValues[sKey] !== undefined);
			var fBaseValue = bHasBaseline ? baselineValues[sKey] : oProp.getValue(0);
			// A morph the character dialed to a non-zero base is its OWN shape — the
			// base ROM only borrowed it. Re-keying it here is exactly what doubled
			// the value; leave character-owned morphs alone, close only ROM poses.
			if(bHasBaseline && !approx_eq(fBaseValue, 0)) continue;
			if(approx_eq(oProp.getKeyValue(iLastKey), fBaseValue)) continue;
			oProp.setValue(tBoundary, fBaseValue);
			verbose("Closed dangling key:", oProp.getLabel(), "back to", fBaseValue, "at frame", iBoundaryFrame);
			iClosed++;
		}
	}
	print("Closed", iClosed, "dangling morph key(s) at frame", iBoundaryFrame);
}

/** **************************************************************************/
function createMorphFrameByKey( oProperty, iFrame, fValue, iKey){
	if(iKey < 1){
		//verbose("")
		return false;
	}
	if( !oProperty ){
		print("Error: Property is null.");
		return false;	
	}
	if( !oProperty.inherits("DzFloatProperty")){
		print("Error: Property is not a DzFloatProperty.");		
		return false;	
	}
		verbose("Property: " + oProperty.getLabel() );
	var timeStep = Scene.getTimeStep();
	var tTarget = iFrame * timeStep;
	var tPrev = iFrame * timeStep - timeStep;
	var tNext = iFrame * timeStep + timeStep;
	var fPrevValue = oProperty.getKeyValue(iKey-1);
	var fNextValue = oProperty.getKeyValue(iKey-1);
		
	//Set the target frame to new value		
	// if (tPrev > 0){
		oProperty.setValue(tPrev, fPrevValue);
		verbose("Property ", oProperty.getLabel(), " set at frame ", tPrev/timeStep, "to", fPrevValue);
	// }
	// if (iFrame + 1 < Scene.getAnimRange().end){
		oProperty.setValue(tNext, fNextValue);
		verbose("Property ", oProperty.getLabel(), " set at frame ", tNext/timeStep, " to ", fNextValue);
	// }
	oProperty.setValue(tTarget, fValue);
	verbose("Set morph frame for", oProperty.getLabel(), "at frame", iFrame, "to value", fValue);
	return true;
}

/** **************************************************************************/
// Creates a sawtooth keyframe pattern: adjacent frames are set to fBaseValue,
// target frame is set to fValue. This prevents morph value leakage.
// fBaseValue defaults to 0 if not specified.
/* Creates a morph frame whose value SUSTAINS until the end of its group
** instead of sawtoothing back on the next frame — for additive base poses
** and cumulative group members (Custom ROM Guide generation methods).
**
** Keys: base at iFrame-1 (skipped for ramp continuations of the same prop,
** e.g. AnusOpen 22/35/80), value at iFrame, value held at iGroupEnd, base
** released at iGroupEnd+1.
*/
function createSustainedMorphFrame( oProperty, iFrame, fValue, fBaseValue, iGroupEnd, bRampContinuation ){
	if( !oProperty ){
		print("Error: Property is null.");
		return false;
	}
	if( !oProperty.inherits("DzFloatProperty")){
		print("Error: Property is not a DzFloatProperty.");
		return false;
	}
	fBaseValue = (fBaseValue !== undefined) ? fBaseValue : 0;

	var timeStep = Scene.getTimeStep();
	if (!bRampContinuation) {
		oProperty.setValue((iFrame - 1) * timeStep, fBaseValue);
		verbose("Property", oProperty.getLabel(), "set at frame", iFrame - 1, "to", fBaseValue);
	}
	oProperty.setValue(iFrame * timeStep, fValue);
	if (iGroupEnd > iFrame) {
		oProperty.setValue(iGroupEnd * timeStep, fValue);
	}
	oProperty.setValue((iGroupEnd + 1) * timeStep, fBaseValue);
	verbose("Set sustained morph frame for", oProperty.getLabel(), "at frame", iFrame, "to", fValue, "held until", iGroupEnd);
	return true;
}


function createMorphFrame( oProperty, iFrame, fValue, fBaseValue ){
	if( !oProperty ){
		print("Error: Property is null.");
		return false;
	}
	if( !oProperty.inherits("DzFloatProperty")){
		print("Error: Property is not a DzFloatProperty.");
		return false;
	}
	// Default base value to 0 for true sawtooth anchoring
	fBaseValue = (fBaseValue !== undefined) ? fBaseValue : 0;

	verbose("Property: " + oProperty.getLabel() );
	var timeStep = Scene.getTimeStep();
	var tTarget = iFrame * timeStep;
	var tPrev = iFrame * timeStep - timeStep;
	var tNext = iFrame * timeStep + timeStep;

	// Set adjacent frames to base value (not interpolated value) for true sawtooth
	oProperty.setValue(tPrev, fBaseValue);
	verbose("Property ", oProperty.getLabel(), " set at frame ", tPrev/timeStep, "to", fBaseValue);
	oProperty.setValue(tNext, fBaseValue);
	verbose("Property ", oProperty.getLabel(), " set at frame ", tNext/timeStep, " to ", fBaseValue);
	// Set target frame to the desired value
	oProperty.setValue(tTarget, fValue);
	verbose("Set morph frame for", oProperty.getLabel(), "at frame", iFrame, "to value", fValue);
	return true;
}


/* Sets selected property from DzParametersPane to it's max on the 
** current frame, setting keyframes on the previous and next
** frames to oProperty's current value
**
** - bAdvanceFrame: if true, advances frame after morph successfully sets
** - bWarnOnFail: if true, displays a message box
*/
function createMorphFrameFromSelectedProperty( bAdvanceFrame, bWarnOnFail){

	var oPaneMgr = MainWindow.getPaneMgr();
	var oPane = oPaneMgr.findPane( "DzParametersPane" );
	if( !oPane ){
		print("Error: DzParametersPane was not found.");
		return false;	
	}
	var oEditor = oPane.getNodeEditor();
	//NOTE: not sure if multiple selections are possible
	var aProperties = oEditor.getPropertySelections( true );
	for( var i = 0; i < aProperties.length; i += 1 ){
		var oProperty = aProperties[i];	
		if( createMorphFrame(oProperty, Scene.getTime()/Scene.getTimeStep(), 1) ) {
			print("Morph frames for", oProperty.getLabel, "successfully set.");
			if( bAdvanceFrame )
				Scene.stepTime();	
		} else {
			print("Morph frames for", oProperty.getLabel, "failed to set.");
			if( bWarnOnFail )
				MessageBox.critical("Morph frames for " + oProperty.getLabel() + " failed to set.",
									 "Failed to set frames", "&OK");
		}
	}
}

/**********************************************************************
 * Generation-aware figure lookup by ASSET identity. A node's label/name is
 * user-renamable, but the .dsf asset it was instantiated from is not — so the
 * source asset URI is the one rename-proof way to recognize "a Genesis 9
 * figure". Used to auto-select the character's figure instead of aborting on
 * a wrong/missing selection. */

/** The stock figure asset file names per generation ('' / unknown → null,
 *  which callers treat as "no generation check possible"). */
function dthGenerationAssetFiles(sGenesis){
	if (sGenesis == "G9") return ["genesis9.dsf"];
	if (sGenesis == "G8.1") return ["genesis8_1female.dsf", "genesis8_1male.dsf"];
	if (sGenesis == "G8") return ["genesis8female.dsf", "genesis8male.dsf"];
	if (sGenesis == "G3") return ["genesis3female.dsf", "genesis3male.dsf"];
	return null;
}

/**
 * The source-asset file path of ONE element, lowercased ('' when unreadable).
 * Every probe is feature-detected, so a Studio without one degrades to the next
 * instead of erroring.
 */
function dthElementAssetPath(oEl){
	if (!oEl) return "";
	try {
		if (typeof oEl.getAssetUri == "function") {
			var oUri = oEl.getAssetUri();
			if (oUri) {
				if (typeof oUri.getFilePath == "function") {
					var sFp = String(oUri.getFilePath());
					if (sFp) return sFp.toLowerCase();
				}
				var sUri = String(oUri);
				if (sUri) return sUri.toLowerCase();
			}
		}
	} catch (e1) { /* next probe */ }
	try {
		if (typeof oEl.getAssetFileInfo == "function") {
			var oInfo = oEl.getAssetFileInfo();
			if (oInfo && typeof oInfo.getFilePath == "function") {
				var sPath = String(oInfo.getFilePath());
				if (sPath) return sPath.toLowerCase();
			}
		}
	} catch (e2) { /* next probe */ }
	try {
		if (oEl.assetUri != undefined) {
			var sProp = String(oEl.assetUri);
			if (sProp) return sProp.toLowerCase();
		}
	} catch (e3) { /* give up */ }
	return "";
}

/**
 * The node's source-asset file path, lowercased ('' when unreadable).
 *
 * **The asset rides on the OBJECT, not always on the node.** Asking the node
 * alone is what made generation detection fail outright in Daz Studio 4 — the
 * scene morph scan then reported "no Genesis figure could be found" about a
 * figure the same run was keying morphs on (measured 2026-08-10 on a G8.1
 * scene). The product scan has always walked deeper, and demonstrably resolves
 * assets in DS4; this is that same walk: node → object → shape → geometry,
 * taking the first identity anything can give.
 */
function dthNodeAssetPath(oNode){
	if (!oNode) return "";
	var sPath = dthElementAssetPath(oNode);
	if (sPath) return sPath;
	try {
		if (typeof oNode.getObject != "function") return "";
		var oObject = oNode.getObject();
		if (!oObject) return "";
		sPath = dthElementAssetPath(oObject);
		if (sPath) return sPath;
		if (typeof oObject.getCurrentShape != "function") return "";
		var oShape = oObject.getCurrentShape();
		if (!oShape) return "";
		sPath = dthElementAssetPath(oShape);
		if (sPath) return sPath;
		if (typeof oShape.getGeometry != "function") return "";
		var oGeom = oShape.getGeometry();
		if (!oGeom) return "";
		return dthElementAssetPath(oGeom);
	} catch (e) { /* an API difference: '' is the honest answer */ }
	return "";
}

/** Whether `oNode` is a root figure instantiated from the generation's stock
 *  asset. Unknown generation (legacy config) or an unreadable asset URI keeps
 *  the old tolerant behavior: any root DzNode passes. */
function dthIsGenerationFigure(oNode, sGenesis){
	if (!oNode || !oNode.inherits("DzNode")) return false;
	// The unreadable-asset tolerance below applies ONLY to actual figures — a
	// selected non-figure (a prop, Environment Options, …) is never accepted.
	if (!oNode.inherits("DzFigure") && !oNode.inherits("DzSkeleton")) return false;
	var aFiles = dthGenerationAssetFiles(sGenesis);
	if (!aFiles) return true;
	var sPath = dthNodeAssetPath(oNode);
	if (sPath == "") return true;
	for (var i = 0; i < aFiles.length; i++) {
		if (sPath.indexOf("/" + aFiles[i]) >= 0 || sPath == aFiles[i]) return true;
	}
	return false;
}

/** First ROOT figure in the scene instantiated from the generation's stock
 *  asset (multiple = a user error; the first wins). Null when none matches. */
function dthFindGenerationFigure(sGenesis){
	var aFiles = dthGenerationAssetFiles(sGenesis);
	if (!aFiles) return null;
	for (var i = 0; i < Scene.getNumNodes(); i++) {
		var oNode = Scene.getNode(i);
		if (!oNode || oNode.getNodeParent()) continue;
		if (!oNode.inherits("DzFigure") && !oNode.inherits("DzSkeleton")) continue;
		var sPath = dthNodeAssetPath(oNode);
		for (var j = 0; j < aFiles.length; j++) {
			if (sPath.indexOf("/" + aFiles[j]) >= 0 || sPath == aFiles[j]) return oNode;
		}
	}
	return null;
}

/*********************************************************************/
// DzNode : returns this nodes root node, or oNode if it is root
function getNodeRoot(oNode){
	if(oNode && oNode.inherits("DzNode")) {
		parent = oNode;
		while (parent){
			oNode = parent;
			parent = parent.getNodeParent();	
		}
	}
	return oNode;
}

function getSceneNameNoExt(){
	var regexFilename = RegExp("\\w*(?=\\.)");
	var aMatches = regexFilename.exec(Scene.getFilename());
	if (aMatches.length > 0)
		return aMatches[0];
	return undefined;
}


/*********************************************************************/
// String : A function for triggering an action
function triggerAction( sActionName , oSettings)
{
	var oActionMgr = MainWindow.getActionMgr();
	if( !oActionMgr ){
		print("Error: no oActionMgr found");
		return false;
	}
	
	var oAction = oActionMgr.findAction( sActionName );
	if( !oAction ){
		print("Error: no oAction found");
		return false;
	}
	
	if( !oAction.enabled ){
		print("Error:  oAction disabled");
		return false;
	}
	
	if( oSettings ){
		print("Trigger", sActionName, "with settings.");
		oAction.triggerWithSettings( oSettings );
		return true;
	} else {
		print("Trigger", sActionName, "without settings.");
		oAction.trigger();
		return true;
	}
};


function approx_eq(fValue1, fValue2){
	return Math.abs(fValue1 - fValue2) < EPSILON;
}

// Selects one or more nodes for action-based operations (e.g. Object Memorize/Restore)
// oNodes can be a single DzNode or an array of DzNodes
function selectNodes(oNodes) {
    Scene.selectAllNodes(false);
    if (!Array.isArray(oNodes)) {
        oNodes = [oNodes];
    }
    for (var i = 0; i < oNodes.length; i++) {
        if (oNodes[i]) {
            oNodes[i].select(true);
        }
    }
}

// Scans all 10 transform controls on a node for keyframes
// Returns sorted array of unique frame numbers (excluding frame 0)
function getTransformKeyframes(oNode) {
    var timeStep = Scene.getTimeStep();
    var frameMap = {};
    var controls = [
        oNode.getXPosControl(), oNode.getYPosControl(), oNode.getZPosControl(),
        oNode.getXRotControl(), oNode.getYRotControl(), oNode.getZRotControl(),
        oNode.getScaleControl(),
        oNode.getXScaleControl(), oNode.getYScaleControl(), oNode.getZScaleControl()
    ];

    for (var c = 0; c < controls.length; c++) {
        var ctrl = controls[c];
        if (!ctrl) continue;
        for (var k = 0; k < ctrl.getNumKeys(); k++) {
            var frame = Math.round(ctrl.getKeyTime(k) / timeStep);
            if (frame > 0) {
                frameMap[frame] = true;
            }
        }
    }

    var frames = [];
    for (var f in frameMap) {
        frames.push(parseInt(f));
    }
    frames.sort(function(a, b) { return a - b; });
    return frames;
}

// Resolves a node under (or being) oNodeRoot by internal name OR label — the
// same match applyKeyData uses for a ROM pose morph's stored node. Returns
// null when nothing in the tree answers to the name.
function findNodeByNameOrLabel(oNodeRoot, sNode) {
    if (oNodeRoot.getName() == sNode || oNodeRoot.getLabel() == sNode)
        return oNodeRoot;
    var oNode = oNodeRoot.findNodeChild(sNode, true);
    if (!oNode)
        oNode = oNodeRoot.findNodeChildByLabel(sNode, true);
    return oNode;
}

// Restores morphs specified in options.preserveMorphs to their keepValue
// preserveMorphs format: [{ name: "body_ctrl_BreastsUp-Down", keepValue: 1, node: "" }, ...]
// A row's `node` (runtime v74) scopes the lookup to that scene node (matched by
// internal name or label); '' / absent searches the figure root — the only
// place this function ever looked before the field existed.
function restorePreservedMorphs(oNodeRoot, preserveMorphs) {
    if (!preserveMorphs || preserveMorphs.length === 0) {
        return;
    }

    for (var i = 0; i < preserveMorphs.length; i++) {
        var config = preserveMorphs[i];
        if (!config.name) continue;

        var oNode = oNodeRoot;
        if (config.node) {
            oNode = findNodeByNameOrLabel(oNodeRoot, config.node);
            if (!oNode) {
                print("WARNING: preserved morph node not found:", config.node, "(morph:", config.name + ")");
                continue;
            }
        }

        var oProp = oNode.findProperty(config.name);
        if (!oProp) {
            oProp = oNode.findPropertyByLabel(config.name);
        }
        if (!oProp) {
            oProp = getMorphPropFromNode(oNode, config.name);
        }

        if (oProp) {
            // Set all keyframes to keepValue (flattens the animation to constant)
            var numKeys = oProp.getNumKeys();
            if (numKeys > 0) {
                for (var k = 0; k < numKeys; k++) {
                    var keyTime = oProp.getKeyTime(k);
                    oProp.setValue(keyTime, config.keepValue);
                }
            } else {
                oProp.setValue(config.keepValue);
            }
            print("Restored preserved morph:", config.name, "to", config.keepValue);
        } else {
            print("WARNING: Could not find preserved morph:", config.name);
        }
    }
}

// Applies options.frameZeroMorphs — [{ name: "Expand All", value: 1, node: "" }, ...] —
// at frame 0. Without a `node` the row reaches EVERY node of the figure tree
// that carries the morph: the figure root plus each descendant (geografts,
// add-ons, fitted clothing all carry dials of their own, and one name like
// "Expand All" may exist on several items at once — each gets the value). A
// row's `node` (runtime v74) narrows it to the node(s) matching that name or
// label — auto-follow puts a figure morph's twin dial on every conformed item,
// so a fit value meant for one bag would otherwise deform the whole outfit.
// With no other keys on the property the value holds across the whole ROM. A
// name (or scoped node) nothing carries is a Daz-log warning only, never a
// run-log failure: a scene without that clothing is an expected state (a
// per-scene override in the studio can clear the list).
function applyFrameZeroMorphs(oNodeRoot, frameZeroMorphs) {
    if (!frameZeroMorphs || frameZeroMorphs.length === 0) {
        return;
    }
    print("Applying", frameZeroMorphs.length, "frame-0 morph(s) across the figure tree");

    var aNodes = [oNodeRoot].concat(oNodeRoot.getNodeChildren(true));
    for (var i = 0; i < frameZeroMorphs.length; i++) {
        var config = frameZeroMorphs[i];
        if (!config.name) continue;
        var fValue = (config.value === undefined) ? 0 : config.value;

        var iHits = 0;
        for (var n = 0; n < aNodes.length; n++) {
            var oNode = aNodes[n];
            // Scoped row: only the node(s) answering to the stored name/label.
            if (config.node && oNode.getName() != config.node && oNode.getLabel() != config.node)
                continue;
            // Morph modifiers first (most reliable for morphs — see applyKeyData),
            // then plain/controller properties by name and by UI label.
            var oProp = getMorphPropFromNode(oNode, config.name);
            if (!oProp) {
                oProp = oNode.findProperty(config.name);
            }
            if (!oProp) {
                oProp = oNode.findPropertyByLabel(config.name);
            }
            if (!oProp) continue;

            // DAZ Studio 6 pops a "keep limits?" dialog when a value exceeds the
            // property's min/max — disable clamping first (guarded, the method
            // name may differ; same dance as applyKeyData).
            if (typeof oProp.setIsClamped === "function") oProp.setIsClamped(false);
            oProp.setValue(0, fValue);
            iHits++;
            print("Frame-0 morph:", config.name, "=", fValue, "on", oNode.getLabel());
        }
        if (iHits === 0) {
            if (config.node)
                print("WARNING: frame-0 morph", config.name, "not found on node:", config.node);
            else
                print("WARNING: frame-0 morph not found on any node:", config.name);
        }
    }
}

// Returns the rotation control for a bone node given an axis string.
// axis: "XRotate", "YRotate", or "ZRotate"
function getRotationControl(oNode, axis) {
    if (axis === "XRotate") return oNode.getXRotControl();
    if (axis === "YRotate") return oNode.getYRotControl();
    if (axis === "ZRotate") return oNode.getZRotControl();
    print("WARNING: Unknown rotation axis:", axis);
    return null;
}

// Pre-resolves morph property references for a list of morph entries.
// Handles "!" prefix for controller properties vs morph modifiers.
// Returns array of { oProp, range, morphName }.
function resolveMorphProps(oNodeRoot, morphEntries) {
    var resolved = [];
    for (var i = 0; i < morphEntries.length; i++) {
        var entry = morphEntries[i];
        var name = entry.morphName;
        var oProp = null;

        if (name.charAt(0) === "!") {
            // Controller property - strip prefix and find via findProperty/findPropertyByLabel
            var ctrlName = name.substring(1);
            oProp = oNodeRoot.findProperty(ctrlName);
            if (!oProp) {
                oProp = oNodeRoot.findPropertyByLabel(ctrlName);
            }
        } else {
            // Morph modifier - try getMorphPropFromNode first, then fallback
            oProp = getMorphPropFromNode(oNodeRoot, name);

            // Loop through all modifiers and check by label/name
            if (!oProp) {
                var oObj = oNodeRoot.getObject();
                if (oObj) {
                    for (var m = 0; m < oObj.getNumModifiers(); m++) {
                        var mod = oObj.getModifier(m);
                        if (mod.getLabel() === name || mod.getName() === name) {
                            if (mod.getValueChannel) {
                                oProp = mod.getValueChannel();
                            }
                            if (!oProp && mod.getValueControl) {
                                oProp = mod.getValueControl();
                            }
                            if (!oProp && mod.getChannel) {
                                oProp = mod.getChannel(0);
                            }
                            if (oProp) break;
                        }
                    }
                }
            }

            if (!oProp) {
                oProp = oNodeRoot.findProperty(name);
            }
            if (!oProp) {
                oProp = oNodeRoot.findPropertyByLabel(name);
            }
        }

        if (oProp) {
            resolved.push({ oProp: oProp, range: entry.range, morphName: name });
        } else {
            print("WARNING: Could not resolve morph property:", name);
        }
    }
    return resolved;
}

// Applies interpolated morph values based on bone rotation angle.
// Linear interpolation from angle range to value range, clamped.
// Returns count of morphs applied.
function applyMorphModEntries(resolvedEntries, angle, keyTime) {
    var count = 0;
    for (var i = 0; i < resolvedEntries.length; i++) {
        var entry = resolvedEntries[i];
        var aStart = entry.range.angle.start;
        var aEnd = entry.range.angle.end;
        var vStart = entry.range.value.start;
        var vEnd = entry.range.value.end;

        // Clamp angle to the range
        var clampedAngle;
        if (aStart < aEnd) {
            clampedAngle = Math.max(aStart, Math.min(aEnd, angle));
        } else {
            clampedAngle = Math.min(aStart, Math.max(aEnd, angle));
        }

        // Linear interpolation: map angle to value
        var t = (aEnd !== aStart) ? (clampedAngle - aStart) / (aEnd - aStart) : 0;
        var value = vStart + t * (vEnd - vStart);

        entry.oProp.setValue(keyTime, value);
        verbose("  JcmMorphMod:", entry.morphName, "angle:", angle, "-> value:", value);
        count++;
    }
    return count;
}

// Resets morphs that are exclusive to sourceEntries (not in otherEntries) to 0.
// This prevents morphs from one direction lingering when rotation crosses zero.
function resetExclusiveMorphs(sourceEntries, otherEntries, keyTime) {
    for (var i = 0; i < sourceEntries.length; i++) {
        var isShared = false;
        for (var j = 0; j < otherEntries.length; j++) {
            if (sourceEntries[i].morphName === otherEntries[j].morphName) {
                isShared = true;
                break;
            }
        }
        if (!isShared) {
            sourceEntries[i].oProp.setValue(keyTime, 0);
            verbose("  Reset exclusive morph:", sourceEntries[i].morphName, "to 0");
        }
    }
}

// Main function: applies JCM morph modifications based on bone rotation keyframes.
// Reads rotation keyframes from bones specified in jcmMorphMods config,
// then sets morph values proportionally using linear interpolation.
function applyJcmMorphMods(oNodeRoot, jcmMorphMods) {
    if (!jcmMorphMods || jcmMorphMods.length === 0) {
        return;
    }

    var timeStep = Scene.getTimeStep();

    for (var i = 0; i < jcmMorphMods.length; i++) {
        var config = jcmMorphMods[i];
        var oNode = oNodeRoot.findNodeChildByLabel(config.boneLabel, true);
        if (!oNode) {
            oNode = oNodeRoot.findNodeChild(config.boneLabel, true);
        }
        if (!oNode) {
            print("WARNING: Could not find bone node:", config.boneLabel);
            continue;
        }

        var rotCtrl = getRotationControl(oNode, config.axis);
        if (!rotCtrl) {
            print("WARNING: Could not get rotation control for", config.boneLabel, config.axis);
            continue;
        }

        // Pre-resolve morph properties
        var posEntries = resolveMorphProps(oNodeRoot, config.positive || []);
        var negEntries = resolveMorphProps(oNodeRoot, config.negative || []);

        var numKeys = rotCtrl.getNumKeys();
        print("Processing", numKeys, "rotation keyframes on", config.boneLabel, config.axis);

        for (var k = 0; k < numKeys; k++) {
            var keyTime = rotCtrl.getKeyTime(k);
            var angle = rotCtrl.getKeyValue(k);

            if (approx_eq(angle, 0)) {
                // Angle is ~0: reset all morphs to 0
                for (var p = 0; p < posEntries.length; p++) {
                    posEntries[p].oProp.setValue(keyTime, 0);
                }
                for (var n = 0; n < negEntries.length; n++) {
                    negEntries[n].oProp.setValue(keyTime, 0);
                }
            } else if (angle > 0) {
                applyMorphModEntries(posEntries, angle, keyTime);
                resetExclusiveMorphs(negEntries, posEntries, keyTime);
            } else {
                applyMorphModEntries(negEntries, angle, keyTime);
                resetExclusiveMorphs(posEntries, negEntries, keyTime);
            }
        }

        print("Applied JCM morph modifications for", config.boneLabel, config.axis,
              "- positive morphs:", posEntries.length, "negative morphs:", negEntries.length);
    }
}

// Memorizes transform properties for nodes listed in preserveNodeTransforms before ROM loading.
// Uses DAZ's Object Memorize action (DzMemorizeSelectedItemsAction) to store current transforms
// as defaults, with direct accessor save as fallback data.
// preserveNodeTransforms format: [{ nodeLabel: "Left Eye" }, ...]
function memorizeNodeTransforms(oNodeRoot, preserveNodeTransforms) {
    if (!preserveNodeTransforms || preserveNodeTransforms.length === 0) {
        return;
    }

    var resolvedNodes = [];
    for (var i = 0; i < preserveNodeTransforms.length; i++) {
        var config = preserveNodeTransforms[i];
        if (!config.nodeLabel) continue;

        var oNode = oNodeRoot.findNodeChildByLabel(config.nodeLabel, true);
        if (!oNode) {
            print("WARNING: Could not find node for transform memorize:", config.nodeLabel);
            continue;
        }

        config._node = oNode;
        resolvedNodes.push(oNode);

        // Save transform values via direct accessors (fallback data)
        var controls = [
            { label: "XTranslate", ctrl: oNode.getXPosControl() },
            { label: "YTranslate", ctrl: oNode.getYPosControl() },
            { label: "ZTranslate", ctrl: oNode.getZPosControl() },
            { label: "XRotate",    ctrl: oNode.getXRotControl() },
            { label: "YRotate",    ctrl: oNode.getYRotControl() },
            { label: "ZRotate",    ctrl: oNode.getZRotControl() },
            { label: "Scale",      ctrl: oNode.getScaleControl() },
            { label: "XScale",    ctrl: oNode.getXScaleControl() },
            { label: "YScale",    ctrl: oNode.getYScaleControl() },
            { label: "ZScale",    ctrl: oNode.getZScaleControl() }
        ];

        config.savedTransforms = [];
        for (var t = 0; t < controls.length; t++) {
            var ctrl = controls[t].ctrl;
            if (ctrl) {
                config.savedTransforms.push({
                    label: controls[t].label,
                    ctrl: ctrl,
                    value: ctrl.getValue()
                });
                verbose("Saved transform", config.nodeLabel, controls[t].label, "=", ctrl.getValue());
            }
        }
        print("Saved", config.savedTransforms.length, "transforms for node:", config.nodeLabel);
    }

    // Select all target nodes and memorize them via Object Memorize action
    if (resolvedNodes.length > 0) {
        Scene.setTime(0);
        selectNodes(resolvedNodes);
        config._useActions = triggerAction("DzMemorizeSelectedItemsAction");
        if (config._useActions) {
            print("Discovered Object Memorize/Restore actions - will use action-based restore");
        } else {
            print("WARNING: DzMemorizeSelectedItemsAction not available - will use fallback restore");
        }
    }
}

// Restores transform properties for nodes listed in preserveNodeTransforms after ROM loading.
// Primary path: uses DAZ Object Memorize/Restore actions (matching the manual workflow).
// Fallback path: uses direct setValue on all keyframes (if actions not available).
function restoreNodeTransforms(oNodeRoot, preserveNodeTransforms) {
    if (!preserveNodeTransforms || preserveNodeTransforms.length === 0) {
        return;
    }

    var timeStep = Scene.getTimeStep();

    // Check if action-based restore is available (set by memorizeNodeTransforms)
    var useActions = false;
    for (var i = 0; i < preserveNodeTransforms.length; i++) {
        if (preserveNodeTransforms[i]._useActions) {
            useActions = true;
            break;
        }
    }

    if (useActions) {
        // === ACTION-BASED RESTORE (primary path) ===
        print("Using action-based Object Memorize/Restore for transform restoration");

        // Step 1: Collect resolved nodes
        var resolvedNodes = [];
        for (var i = 0; i < preserveNodeTransforms.length; i++) {
            var config = preserveNodeTransforms[i];
            if (!config.nodeLabel) continue;
            var oNode = config._node || oNodeRoot.findNodeChildByLabel(config.nodeLabel, true);
            if (!oNode) continue;
            resolvedNodes.push(oNode);
        }

        // Step 2: At frame 0, restore memorized transforms (captured before ROM loading)
        Scene.setTime(0);
        selectNodes(resolvedNodes);
        triggerAction("DzRestoreSelectedItemsAction");
        print("Restored memorized transforms at frame 0");

        // Step 3: Memorize Figure (captures corrected frame 0 as figure defaults)
        Scene.selectAllNodes(false);
        oNodeRoot.select(true);
        Scene.setPrimarySelection(oNodeRoot);
        triggerAction("DzMemorizeFigureAction");
        print("Memorized figure for root node at frame 0");

        // Step 4: Scan keyframes on all target nodes' transform controls
        var allFrames = {};
        for (var i = 0; i < preserveNodeTransforms.length; i++) {
            var config = preserveNodeTransforms[i];
            var oNode = config._node || oNodeRoot.findNodeChildByLabel(config.nodeLabel, true);
            if (!oNode) continue;

            var nodeFrames = getTransformKeyframes(oNode);
            for (var f = 0; f < nodeFrames.length; f++) {
                allFrames[nodeFrames[f]] = true;
            }
        }

        var frameList = [];
        for (var f in allFrames) {
            frameList.push(parseInt(f));
        }
        frameList.sort(function(a, b) { return a - b; });

        print("Restoring transforms at", frameList.length, "frames:", frameList.join(", "));

        // Step 5: Select all target nodes, then restore at each keyframe
        selectNodes(resolvedNodes);
        for (var f = 0; f < frameList.length; f++) {
            Scene.setTime(frameList[f] * timeStep);
            triggerAction("DzRestoreSelectedItemsAction");
            verbose("Restored selected items at frame", frameList[f]);
        }

        print("Action-based transform restoration complete");

    } else {
        // === FALLBACK PATH (direct setValue) ===
        print("Using fallback direct setValue for transform restoration");

        for (var i = 0; i < preserveNodeTransforms.length; i++) {
            var config = preserveNodeTransforms[i];
            if (!config.nodeLabel || !config.savedTransforms) continue;

            for (var t = 0; t < config.savedTransforms.length; t++) {
                var entry = config.savedTransforms[t];
                var ctrl = entry.ctrl;
                if (!ctrl) continue;

                var savedValue = entry.value;
                var numKeys = ctrl.getNumKeys();
                if (numKeys > 0) {
                    for (var k = 0; k < numKeys; k++) {
                        ctrl.setValue(ctrl.getKeyTime(k), savedValue);
                    }
                } else {
                    ctrl.setValue(savedValue);
                }
                print("Restored transform", config.nodeLabel, entry.label, "=", savedValue, "(keys:", numKeys + ")");
            }

            print("Restored transforms for node:", config.nodeLabel);
        }
    }
}

// Apply the character's art-direction frames (inline `config.gpArtDirection` /
// `config.dkArtDirection` of the single-file character script) onto the GP/DK
// ROM block starting at `startFrame`.
function applyArtDirectionData(jsonData, oNodeRoot, startFrame) {
    if (!jsonData || !jsonData.frames || !Array.isArray(jsonData.frames)) {
        print("ERROR: art direction data missing 'frames' array");
        return false;
    }

    var timeStep = Scene.getTimeStep();
    var appliedCount = 0;

    for (var i = 0; i < jsonData.frames.length; i++) {
        var frameEntry = jsonData.frames[i];
        var absoluteFrame = parseInt(frameEntry.frame) + startFrame;

        if (!frameEntry.morphs || frameEntry.morphs.length === 0) {
            continue;
        }

        print("Applying GP art direction for", frameEntry.name, "at frame", absoluteFrame);

        for (var j = 0; j < frameEntry.morphs.length; j++) {
            var morph = frameEntry.morphs[j];

            // Find the node
            var oNode;
            if (oNodeRoot.getName() === morph.node || oNodeRoot.getLabel() === morph.node) {
                oNode = oNodeRoot;
            } else {
                oNode = oNodeRoot.findNodeChild(morph.node, true);
            }
            if (!oNode) {
                oNode = oNodeRoot.findNodeChildByLabel(morph.node, true);
            }

            if (!oNode) {
                logRunFailedMorph(absoluteFrame, morph.node, morph.prop, "node not found (art direction)");
                continue;
            }

            // Find the property
            var oProp = getMorphPropFromNode(oNode, morph.prop);
            if (!oProp) {
                var oObj = oNode.getObject();
                if (oObj) {
                    for (var m = 0; m < oObj.getNumModifiers(); m++) {
                        var mod = oObj.getModifier(m);
                        if (mod.getLabel() === morph.prop || mod.getName() === morph.prop) {
                            if (mod.getValueChannel) oProp = mod.getValueChannel();
                            if (!oProp && mod.getValueControl) oProp = mod.getValueControl();
                            if (oProp) break;
                        }
                    }
                }
            }

            // LAST RESORT: node property lookup. Geo-graft "preset" morphs (e.g.
            // Golden Palace GP_PR_*) are exposed on the figure as alias PROPERTIES,
            // not as modifiers on its object — so findModifier/getModifier miss
            // them. findProperty catches them, same as the FBM path (applyKeyData).
            if (!oProp) {
                oProp = oNode.findProperty(morph.prop);
                if (oProp) print("  Found via findProperty (fallback)");
            }
            if (!oProp) {
                oProp = oNode.findPropertyByLabel(morph.prop);
                if (oProp) print("  Found via findPropertyByLabel (fallback)");
            }

            if (!oProp) {
                logRunFailedMorph(absoluteFrame, morph.node, morph.prop, "morph/property not found (art direction)");
                continue;
            }

            // Apply the morph value at this frame using sawtooth pattern
            createMorphFrame(oProp, absoluteFrame, morph.value);
            print("  Set", morph.prop, "=", morph.value, "at frame", absoluteFrame, "(sawtooth)");
            appliedCount++;
        }
    }

    print("Applied", appliedCount, "GP art direction morphs");
    return true;
}